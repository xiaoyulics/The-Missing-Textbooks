%% rosetta.sty -- volume style for "The Replica Rosetta Stone"
%% (The Missing Textbooks, volume 7). Loaded after missingbook.cls by main.tex and by
%% tools/build_chapter.sh. Chapters must not load packages of their own.
%%
%% The book sets two languages side by side, and the design gives each a voice. Physics, the
%% derivation by replicas, cavities and saddle points, writes in carnelian. Proof, the rigorous
%% route by interpolation, conditioning and comparison, writes in lapis. The structure of the book
%% is cut in granite, the neutral stone that carries both. The ornaments come from the Rosetta
%% Stone, which carries one decree in three scripts. Under each chapter title run three registers:
%% physics on top and broken off short, as the hieroglyphic register of the stone is, numerics in
%% the middle, and proof below at full length. At the foot of each opening page sits a small stone
%% whose three registers show the rigor status of the chapter's main prediction: the proof register
%% is filled when the prediction is proved, half filled when it is proved under extra hypotheses or
%% in part, outlined when it is a conjecture, struck through when it is known to be false. The title
%% page carries one fact in three registers: Gardner's formula for the capacity of the perceptron,
%% its curve, and the theorem that proves it. The series class is not modified: its colour names
%% are re-pointed to this palette and its ornament macros are redefined here.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{rosetta}[2026/10/24 v1.0 volume style for The Replica Rosetta Stone]

\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween,groupplots}
\usetikzlibrary{fadings,patterns}
\RequirePackage{siunitx}

%------------------------------------------------------------------------------
% Palette
%------------------------------------------------------------------------------
\definecolor{stone}{RGB}{84,72,90}          % granite: the structure of the book, links
\definecolor{stonedeep}{RGB}{50,42,56}      % part titles, imprint
\definecolor{stonelight}{RGB}{232,228,233}  % the slab of the ornaments
\definecolor{physics}{RGB}{168,66,38}       % carnelian: the physical derivation
\definecolor{physicswash}{RGB}{251,241,235} % tint of the physics side
\definecolor{proof}{RGB}{26,80,138}         % lapis: the rigorous route
\definecolor{proofwash}{RGB}{235,242,250}   % tint of the proof side
\definecolor{papyrus}{RGB}{247,244,237}     % tint of definition and computation boxes
\definecolor{papyrusline}{RGB}{196,186,167} % rules of those boxes
% the series class draws with these names
\colorlet{sea}{stone}
\colorlet{seadeep}{stonedeep}
\colorlet{seafoam}{proofwash}
\colorlet{seamist}{stone!12}
\colorlet{sand}{papyrus}
\colorlet{sandline}{papyrusline}
\hypersetup{linkcolor=stone,citecolor=stone,urlcolor=stone}

% the chapter number in the margin, in a light granite
\renewcommand*{\mb@chapnumfont}{\normalfont\fontsize{64}{64}\selectfont\color{stone!40}}

%------------------------------------------------------------------------------
% Three registers: a short carnelian rule (physics, broken off like the stone's hieroglyphic
% register), a granite rule (numerics) and a full lapis rule (proof). They replace the series'
% wave rule under chapter titles and on part pages.
%------------------------------------------------------------------------------
\newlength{\rst@len}
\newcommand*{\rst@registers}[1]{%
  \setlength{\rst@len}{#1}%
  \begin{tikzpicture}[x=1mm,y=1mm,baseline=0pt]
    \draw[physics!85,line width=0.55pt] (0,1.5) -- (0.42\rst@len,1.5) -- ++(1.1,0.55);
    \draw[stone!70,line width=0.45pt] (0,0.75) -- (0.71\rst@len,0.75);
    \draw[proof!85,line width=0.55pt] (0,0) -- (\rst@len,0);
  \end{tikzpicture}}
\renewcommand*{\mb@waverule}[1][]{%
  \par\noindent\makebox[\linewidth][l]{%
    \rst@registers{\dimexpr\linewidth+\marginparsep+\marginparwidth\relax}}\par}

%------------------------------------------------------------------------------
% The status stone: a small slab with three registers. The top (physics) and the middle
% (numerics) are always filled; the bottom (proof) shows the status of the chapter's main
% prediction.
%   \statusstone{proved|partial|conjectured|false|open}       inline, at the current size
%   \stonefoot{status}                                         at the foot of the opening page
%------------------------------------------------------------------------------
\newcommand{\rst@slab}[1]{% #1: status
  % the slab, with its top-left corner broken off
  \fill[stonelight] (0,0) -- (12,0) -- (12,9.4) -- (4.2,9.4) -- (2.6,8.1) -- (0,8.6) -- cycle;
  \draw[stone!55,line width=0.35pt] (0,0) -- (12,0) -- (12,9.4) -- (4.2,9.4) -- (2.6,8.1) -- (0,8.6) -- cycle;
  % physics register
  \foreach \rst@x in {1.4,3.1,4.8,6.5,8.2,9.9}{\fill[physics!80] (\rst@x,6.5) rectangle ++(1.1,1.0);}
  % numerics register
  \foreach \rst@x in {1.4,2.6,3.8,5.0,6.2,7.4,8.6,9.8}{\fill[stone!65] (\rst@x,4.25) rectangle ++(0.75,0.75);}
  % proof register
  \def\rst@status{#1}%
  \def\rst@proved{proved}\def\rst@partial{partial}\def\rst@conj{conjectured}%
  \def\rst@false{false}\def\rst@open{open}%
  \ifx\rst@status\rst@proved
    \fill[proof] (1.4,1.3) rectangle (10.6,2.9);
  \else\ifx\rst@status\rst@partial
    \fill[proof] (1.4,1.3) rectangle (6.0,2.9);
    \draw[proof,line width=0.4pt] (1.4,1.3) rectangle (10.6,2.9);
  \else\ifx\rst@status\rst@conj
    \draw[proof,line width=0.4pt,dash pattern=on 0.9pt off 0.7pt] (1.4,1.3) rectangle (10.6,2.9);
  \else\ifx\rst@status\rst@false
    \draw[physics,line width=0.45pt] (1.4,1.3) rectangle (10.6,2.9);
    \draw[physics,line width=0.6pt] (1.1,0.9) -- (10.9,3.3);
  \else
    \draw[stone!60,line width=0.4pt,dash pattern=on 0.5pt off 0.8pt] (1.4,1.3) rectangle (10.6,2.9);
  \fi\fi\fi\fi}
\newcommand{\statusstone}[1]{%
  \begin{tikzpicture}[x=0.16em,y=0.16em,baseline=0pt]\rst@slab{#1}\end{tikzpicture}}
\newcommand*{\rst@statusword}[1]{%
  \def\rst@status{#1}\def\rst@proved{proved}\def\rst@partial{partial}\def\rst@conj{conjectured}%
  \def\rst@false{false}%
  \ifx\rst@status\rst@proved proved\else\ifx\rst@status\rst@partial proved in part\else
  \ifx\rst@status\rst@conj conjectured\else\ifx\rst@status\rst@false known false\else open\fi\fi\fi\fi}
% The foot stone sits in the bottom margin under the margin column (the text block and the margin
% column end 31 mm above the bottom edge), so that it never meets a side note.
\newcommand*{\rst@footx}{171}  % mm from the left edge of the page
\newcommand*{\rst@footy}{8}    % mm from the bottom edge of the page
\newcommand{\stonefoot}[1]{%
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=1mm]
    \begin{scope}[shift={(current page.south west)}]
      \begin{scope}[shift={(\rst@footx,\rst@footy)},x=1.25mm,y=1.25mm]
        \rst@slab{#1}
        \node[font=\sffamily\tiny,text=stone,anchor=east,inner sep=0pt,align=right] at (-1.6,4.7)
          {\textsc{\color{physics}physics}\\[0.3ex]\textsc{numerics}\\[0.3ex]\textsc{\color{proof}\rst@statusword{#1}}};
      \end{scope}
    \end{scope}
  \end{tikzpicture}}
% \rst@ifblank{text}{if blank}{otherwise}, safe for arguments that contain mathematics
\newcommand{\rst@ifblank}[1]{\if\relax\detokenize{#1}\relax\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
% the class calls \risingsea on part pages; here its argument is a status (or empty for none)
\renewcommand*{\risingsea}[1]{\rst@ifblank{#1}{}{\stonefoot{#1}}}

%------------------------------------------------------------------------------
% Chapter openings
%   \rstchapter{Title}{Subtitle}{the dictionary}{label}
% prints the title, the subtitle, "the dictionary -- <physics method> / <rigorous method>", and the
% three registers; the chapter's status stone follows on the next line of the source:
% \stonefoot{status}.
%   \specialchapter{Title}{Subtitle}{status}     unnumbered (prologue, epilogue, colophon)
%   \appendixchapter{Title}{Subtitle}{label}     the appendix (no stone)
%   \casepart{Title}{Blurb}{status}              part pages
%------------------------------------------------------------------------------
\newcommand*{\rst@chapdict}{}
\newcommand*{\rst@tocsubtitle}[2]{%
  \par\nopagebreak\vspace{-0.15ex}{\leftskip=2.3em\small\itshape\color{muted}#1%
    \rst@ifblank{#2}{}{\unskip\nobreak\hfil\penalty50\hskip1.5em\hbox{}\nobreak\hfil
      \mbox{\upshape\color{stone}#2}{\parfillskip=0pt\finalhyphendemerits=0\par}}\par}\vspace{0.35ex}}
\newcommand{\rst@openerblock}[2]{%
  \vspace*{-0.2\baselineskip}%
  {\raggedright\large\itshape\color{muted}#1\par}%
  \rst@ifblank{#2}{}{%
    \vspace{0.55\baselineskip}%
    {\raggedright\small\textsc{\color{stone}the dictionary}\enspace{\color{stone}\rule[0.32ex]{1.6em}{0.4pt}}\enspace #2\par}}%
  \vspace{0.5\baselineskip}%
  \mb@waverule
  \vspace{0.9\baselineskip}}
% the dictionary is written "physics method \dict rigorous method"
\newcommand*{\dict}{\enspace{\color{stone}$\leftrightarrow$}\enspace}
\newcommand{\rstchapter}[4]{%
  \chapter[head={#1},tocentry={#1}]{#1}\label{#4}%
  \addtocontents{toc}{\protect\rst@tocsubtitle{#2}{#3}}%
  \gdef\rst@chapdict{#3}%
  \rst@openerblock{#2}{#3}%
  \@afterindentfalse\@afterheading}
\newcommand{\appendixchapter}[3]{%
  \chapter[head={#1},tocentry={#1}]{#1}\label{#3}%
  \addtocontents{toc}{\protect\mbtocsubtitle{#2}}%
  \gdef\rst@chapdict{}%
  \rst@openerblock{#2}{}%
  \@afterindentfalse\@afterheading}
\renewcommand{\casechapter}[4]{\rstchapter{#1}{#2}{#3}{#4}}
\renewcommand{\specialchapter}[3]{%
  \addchap[head={#1},tocentry={#1}]{#1}%
  \addtocontents{toc}{\protect\mbtocsubtitle{#2}}%
  \gdef\rst@chapdict{}%
  \risingsea{#3}%
  \rst@openerblock{#2}{}%
  \@afterindentfalse\@afterheading}
\renewcommand{\casepart}[3]{%
  \setpartpreamble[c][0.78\textwidth]{%
    \vspace{2.2\baselineskip}{\centering\rst@registers{\linewidth}\par}\vspace{1.2\baselineskip}%
    {\normalfont\itshape\color{muted}\setlength{\parindent}{0pt}#2\par}%
    \risingsea{#3}}%
  \part{#1}}

% Figures and tables of an unnumbered chapter (the prologue, the epilogue) are numbered with a
% letter: \rstfloatprefix{P} after its heading, \rstfloatrestore at its end.
\newcommand*{\rstfloatprefix}[1]{%
  \global\let\rst@origthefigure\thefigure\global\let\rst@origthetable\thetable
  \global\let\rst@origtheHfigure\theHfigure\global\let\rst@origtheHtable\theHtable
  \setcounter{figure}{0}\setcounter{table}{0}%
  \gdef\thefigure{#1.\arabic{figure}}\gdef\thetable{#1.\arabic{table}}%
  \gdef\theHfigure{#1.\arabic{figure}}\gdef\theHtable{#1.\arabic{table}}}
\newcommand*{\rstfloatrestore}{%
  \global\let\thefigure\rst@origthefigure\global\let\thetable\rst@origthetable
  \global\let\theHfigure\rst@origtheHfigure\global\let\theHtable\rst@origtheHtable
  \setcounter{figure}{0}\setcounter{table}{0}}

%------------------------------------------------------------------------------
% Title page: one fact in three registers on a granite slab. Physics: Gardner's replica formula
% for the capacity of the spherical perceptron with margin kappa. Numerics: its curve (from
% figures/scripts/00-emblem.py, which writes figures/data/00-emblem.tex with \rstemblemcurve,
% a list of points kappa/alpha). Proof: the theorem that establishes it.
%------------------------------------------------------------------------------
\newcommand*{\rst@ex}{98}    % mm: lower left corner of the slab
\newcommand*{\rst@ey}{20}
\newcommand*{\rst@emblem}{%
  \begin{scope}[shift={(\rst@ex,\rst@ey)}]
    \fill[stonelight] (0,0) -- (96,0) -- (96,104) -- (30,104) -- (20,94) -- (9,99) -- (0,91) -- cycle;
    \draw[stone!45,line width=0.5pt] (0,0) -- (96,0) -- (96,104) -- (30,104) -- (20,94) -- (9,99) -- (0,91) -- cycle;
    % register lines
    \draw[stone!30,line width=0.35pt] (6,70) -- (90,70);
    \draw[stone!30,line width=0.35pt] (6,30) -- (90,30);
    % physics: the replica formula
    \node[text=physics,anchor=west,font=\small] at (8,82)
      {$\displaystyle\frac{1}{\alpha_c(\kappa)}=\int_{-\kappa}^{\infty}\!(z+\kappa)^2\,\mathrm{D}z$};
    \node[text=physics!80,anchor=west,font=\scriptsize\itshape] at (8,74.5) {Gardner 1988, by replicas};
    % numerics: the curve, proved for kappa >= 0 (solid), an upper bound only for kappa < 0 (dotted)
    \begin{scope}[shift={(30,36)},x=11mm,y=3.9mm]
      \draw[stone!55,line width=0.3pt] (-0.85,0) -- (3.45,0);
      \draw[stone!55,line width=0.3pt] (0,0) -- (0,7.0);
      \IfFileExists{figures/data/00-emblem.tex}{%
        \input{figures/data/00-emblem.tex}%
        \draw[physics!80,line width=0.7pt,dash pattern=on 0.8pt off 1.2pt,line cap=round] plot coordinates {\rstemblemcurveneg};
        \draw[stone,line width=0.8pt,line join=round] plot coordinates {\rstemblemcurve};}{}
      \fill[proof] (0,2) circle (0.45mm);
      \node[font=\sffamily\tiny,text=stone,anchor=north] at (3.45,0) {$\kappa$};
      \node[font=\sffamily\tiny,text=stone,anchor=east] at (0,7.0) {$\alpha_c$};
      \node[font=\sffamily\tiny,text=proof,anchor=west] at (0.12,2.15) {$2$};
    \end{scope}
    % proof: the theorem
    \node[text=proof,anchor=north west,font=\scriptsize,text width=80mm,align=left] at (8,26)
      {\textsc{theorem.}\enspace For $\kappa\ge0$ the capacity of the spherical perceptron is
       $\alpha_c(\kappa)$; at $\kappa=0$ it is $2$.\\[0.6ex]
       {\itshape Shcherbina and Tirozzi; Stojnic; Talagrand}};
  \end{scope}}
\renewcommand{\mbtitlepage}[4]{%
  \begin{titlepage}
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=1mm]
    \begin{scope}[shift={(current page.south west)}]\rst@emblem\end{scope}
  \end{tikzpicture}%
  \setlength{\parindent}{0pt}%
  \vspace*{18mm}
  {\large\scshape\color{stone}the missing textbooks\par}
  \vspace{14mm}
  \makebox[\textwidth][l]{\parbox{\dimexpr\textwidth+\marginparsep+\marginparwidth\relax}{\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000
    \fontsize{44}{50}\selectfont\color{ink}#1}}\par
  \vspace{7mm}
  {\LARGE\itshape\color{muted}#2\par}
  \vspace{20mm}
  {\Large #3\par}
  \vfill
  {\small\color{stonedeep}#4\par}
  \vspace*{6mm}
  \end{titlepage}}

%------------------------------------------------------------------------------
% Theorem-like environments of this volume (sharing the chapter's theorem counter)
%------------------------------------------------------------------------------
\theoremstyle{mbdefinition}
\mb@newsharedtheorem{assumption}{Assumption}
\tcolorboxenvironment{assumption}{mbdef}
\theoremstyle{mbremark}
\mb@newsharedtheorem{observation}{Observation}
\tcbset{rst@observation/.style={enhanced,breakable,colback=white,frame hidden,boxrule=0pt,arc=0pt,
    borderline west={0.6pt}{0pt}{stone!60},left=3.2mm,right=0mm,top=0.6mm,bottom=0.6mm,
    before skip=1.1ex plus 0.4ex,after skip=1.1ex plus 0.4ex}}
\tcolorboxenvironment{observation}{rst@observation}
\crefname{assumption}{Assumption}{Assumptions}
\crefname{observation}{Observation}{Observations}
\theoremstyle{mbplain}

% A heuristic derivation is an argument that is not a proof. It ends with a diamond instead of
% the tombstone, and \qedhere works inside it as in a proof.
\newcommand*{\rst@diamond}{\leavevmode\unskip\penalty9999 \hbox{}\nobreak\hfill\quad\hbox{$\Diamond$}}
\newenvironment{heuristic}[1][Physical derivation]{\par\pushQED{\rst@diamond}\normalfont
  \topsep5\p@\@plus5\p@\relax\trivlist\item[\hskip\labelsep\scshape\color{physics}#1.]\ignorespaces}
  {\popQED\endtrivlist\@endpefalse}

%------------------------------------------------------------------------------
% Signature boxes of this volume
%------------------------------------------------------------------------------
% \begin{physicsbox}[short title] ... \end{physicsbox}: the physical prediction, as physicists
% state it
\newtcolorbox{physicsbox}[1][]{enhanced,breakable,colback=physicswash,frame hidden,boxrule=0pt,arc=0pt,
  borderline west={1.3pt}{0pt}{physics},left=3.2mm,right=3mm,top=1.8mm,bottom=1.8mm,
  before skip=1.5ex plus 0.5ex,after skip=1.5ex plus 0.5ex,
  before upper={\textsc{\color{physics}the physical prediction}\rst@ifblank{#1}{}{\enspace{\color{physics}\textperiodcentered}\enspace#1}%
    {\color{physics}.}\enspace}}

% The stone: the physical derivation and the rigorous route side by side, step by step, across the
% full width of the page (text block and margin).
%   \begin{stone}{physics heading}{proof heading}
%     \stonestep{name of the step}{physics side}{proof side}
%     ...
%   \end{stone}
% Each step is one unbreakable row; the page may break between rows, so a row should be at most a
% third of a page. The sides may hold displayed mathematics; they may not hold side notes,
% footnotes or floats.
\newlength{\rst@colw}
\newcounter{rst@step}
\newenvironment{stone}[2]{%
  \par\addvspace{1.6ex}\setcounter{rst@step}{0}%
  \begin{fullwidth}
  \setlength{\rst@colw}{\dimexpr(\linewidth-6mm)/2\relax}%
  \noindent\begin{tikzpicture}[x=1mm,y=1mm,baseline=0pt]
    \draw[physics,line width=0.8pt] (0,0) -- (\rst@colw,0);
    \draw[proof,line width=0.8pt] (\rst@colw+6mm,0) -- (2\rst@colw+6mm,0);
  \end{tikzpicture}\par\nopagebreak\vspace{0.4ex}%
  \noindent\parbox[t]{\rst@colw}{\raggedright\small\textsc{\color{physics}physics}\enspace{\color{physics}\textperiodcentered}\enspace\itshape#1}\hspace{6mm}%
  \parbox[t]{\rst@colw}{\raggedright\small\textsc{\color{proof}proof}\enspace{\color{proof}\textperiodcentered}\enspace\itshape#2}\par
  \nopagebreak\vspace{0.8ex}}
  {\par\noindent\begin{tikzpicture}[x=1mm,y=1mm,baseline=0pt]
    \draw[physics!50,line width=0.4pt] (0,0) -- (\rst@colw,0);
    \draw[proof!50,line width=0.4pt] (\rst@colw+6mm,0) -- (2\rst@colw+6mm,0);
  \end{tikzpicture}\par\end{fullwidth}\par\addvspace{1.6ex}}
\newcommand{\stonestep}[3]{%
  \refstepcounter{rst@step}%
  % the page may break before a row, but not between the header and the first row
  \par\ifnum\value{rst@step}>1 \penalty-50\else\nopagebreak\fi\vspace{0.6ex}%
  \noindent\begin{minipage}[t]{\linewidth}%
    {\small\sffamily\color{stone}\arabic{rst@step}\enspace\textperiodcentered\enspace#1\par}\vspace{0.3ex}%
    \begin{tcolorbox}[enhanced,colback=physicswash,frame hidden,boxrule=0pt,arc=0pt,
        borderline west={0.8pt}{0pt}{physics!70},left=2.4mm,right=2mm,top=1mm,bottom=1mm,
        width=\rst@colw,box align=top,nobeforeafter,valign=top,equal height group=rst@row\arabic{chapter}x\arabic{rst@step}]
      #2\end{tcolorbox}\hspace{6mm}%
    \begin{tcolorbox}[enhanced,colback=proofwash,frame hidden,boxrule=0pt,arc=0pt,
        borderline west={0.8pt}{0pt}{proof!70},left=2.4mm,right=2mm,top=1mm,bottom=1mm,
        width=\rst@colw,box align=top,nobeforeafter,valign=top,equal height group=rst@row\arabic{chapter}x\arabic{rst@step}]
      #3\end{tcolorbox}%
  \end{minipage}\par}

% The status board: every prediction of the chapter with its rigor status.
%   \begin{statusboard}
%     \statusrow{prediction}{\proved}{where it is proved, or the evidence}
%   \end{statusboard}
% Statuses: \proved, \provedunder (proved under extra hypotheses, which the third column names),
% \provedpreprint (proved only in an unrefereed preprint), \conjectured, \heuristicstatus (an
% argument without a claim of exactness), \knownfalse, \openq.
\tikzset{rst@badge/.style={inner xsep=0.45em,inner ysep=0.22em,font=\scriptsize\sffamily,
    rounded corners=0.6pt,line width=0.45pt,text depth=0.1ex,text height=1.45ex}}
\newcommand*{\rst@badge}[3]{% #1 colour, #2 filled (1) or outlined (0), #3 word
  \ifnum#2=1
    \tikz[baseline=(b.base)]\node[rst@badge,fill=#1,text=white,draw=#1] (b) {#3};%
  \else
    \tikz[baseline=(b.base)]\node[rst@badge,draw=#1,text=#1] (b) {#3};%
  \fi}
\newcommand*{\proved}{\rst@badge{proof}{1}{proved}}
\newcommand*{\provedunder}{\rst@badge{proof}{0}{proved under}}
% proved only in an unrefereed preprint (the third column names it, with its arXiv version)
\newcommand*{\provedpreprint}{\tikz[baseline=(b.base)]\node[rst@badge,draw=proof,text=proof,
    dash pattern=on 1.1pt off 0.8pt] (b) {preprint};}
\newcommand*{\conjectured}{\rst@badge{physics}{0}{conjectured}}
\newcommand*{\heuristicstatus}{\rst@badge{stone}{0}{heuristic}}
\newcommand*{\knownfalse}{\rst@badge{physics}{1}{false}}
\newcommand*{\openq}{\rst@badge{stone}{0}{open}}
\newcommand{\statusrow}[3]{%
  \par\noindent\hangindent=0pt
  \parbox[t]{0.40\linewidth}{\raggedright\strut#1\strut}\hfill
  \parbox[t]{5.8em}{\raggedright\strut#2}\hfill
  \parbox[t]{\dimexpr0.60\linewidth-6.8em\relax}{\raggedright\leavevmode\strut{\color{ink!85}#3}\strut}\par\vspace{0.7ex}}
\newcommand*{\rst@dictplain}{\enspace$\leftrightarrow$\enspace}
\newenvironment{statusboard}{%
  \begin{tcolorbox}[enhanced,breakable,colback=white,colframe=stone!50,boxrule=0.5pt,arc=0pt,
    left=3mm,right=3mm,top=1.9mm,bottom=0.6mm,
    title={\textsc{status board}\ifx\rst@chapdict\@empty\else\enspace\textperiodcentered\enspace{\let\dict\rst@dictplain\rst@chapdict}\fi},
    fonttitle=\normalfont,coltitle=white,colbacktitle=stone,toptitle=1mm,bottomtitle=1mm,
    before skip=1.8ex,after skip=1.8ex,fontupper=\small]
  \noindent\parbox[t]{0.40\linewidth}{\textsc{\color{stone}prediction}}\hfill
  \parbox[t]{5.8em}{\textsc{\color{stone}status}}\hfill
  \parbox[t]{\dimexpr0.60\linewidth-6.8em\relax}{\textsc{\color{stone}proof or evidence}}\par\vspace{0.6ex}%
  {\color{stone!35}\hrule height 0.4pt}\vspace{0.9ex}}
  {\end{tcolorbox}}

% \begin{computation}{Title} \step ... \step ... \end{computation}
% A computation by hand on a running example, written as numbered steps. Numbered
% "Computation N.k"; label comp:key:name.
\newcounter{computation}[chapter]
\renewcommand*{\thecomputation}{\thechapter.\arabic{computation}}
\crefname{computation}{Computation}{Computations}
\newcounter{rst@cstep}
\newcommand{\step}{\item}
\newenvironment{computation}[1]{%
  \refstepcounter{computation}\def\@currentlabelname{#1}%
  \begin{tcolorbox}[enhanced,breakable,colback=papyrus,frame hidden,boxrule=0pt,arc=0pt,
    borderline north={0.5pt}{0pt}{stone!80},borderline south={0.5pt}{0pt}{stone!80},
    left=3.4mm,right=3.4mm,top=1.2mm,bottom=1.8mm,
    title={\textsc{computation \thecomputation}\enspace\textperiodcentered\enspace\textsc{#1}},
