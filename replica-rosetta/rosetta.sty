\pgfplotscreateplotcyclelist{rstcycle}{%
  {physics,line width=1.0pt},%
  {proof,line width=1.0pt,dashed},%
  {stone,line width=1.0pt,densely dotted},%
  {muted,line width=0.9pt,dashdotted}}
\pgfplotsset{
  rplot/.style={width=0.92\linewidth,height=0.58\linewidth,
    axis line style={muted!80},tick style={muted!80},major tick length=2.5pt,
    every tick label/.append style={font=\footnotesize,text=ink},
    label style={font=\small,text=ink},title style={font=\small},
    legend style={draw=none,fill=white,fill opacity=0.85,text opacity=1,font=\footnotesize},
    legend cell align=left,cycle list name=rstcycle,scaled ticks=false,
    tick label style={/pgf/number format/fixed}},
  % the physical prediction (carnelian, solid); a rigorous bound or proved curve (lapis, dashed)
  physpred/.style={physics,line width=1.0pt,no marks},
  physpred2/.style={physics!55,line width=0.9pt,densely dotted,no marks},
  proofpred/.style={proof,line width=0.95pt,dash pattern=on 3pt off 2pt,no marks},
  % measurements: filled ink circles; hollow carnelian circles and lapis squares for more series
  measured/.style={only marks,mark=*,mark size=1.6pt,color=ink,
    mark options={fill=ink,draw=white,line width=0.2pt}},
  measured2/.style={only marks,mark=o,mark size=1.7pt,color=physics,
    mark options={line width=0.6pt,fill=white}},
  measured3/.style={only marks,mark=square,mark size=1.5pt,color=proof,
    mark options={line width=0.6pt,fill=white}},
  ebars/.style={error bars/y dir=both,error bars/y explicit,
    error bars/error bar style={line width=0.5pt},
    error bars/error mark options={rotate=90,mark size=1.6pt,line width=0.5pt}},
  guide/.style={muted,line width=0.5pt,densely dashed,no marks},
  band/.style={fill=stone!12,draw=none},
}

