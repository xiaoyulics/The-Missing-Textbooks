%% singular.sty -- volume style for "Singular Learning Theory for the Rest of Us"
%% (The Missing Textbooks, volume 6). Loaded after missingbook.cls by main.tex and by
%% tools/build_chapter.sh. Chapters must not load packages of their own.
%%
%% The design has two voices. The singular theory, which the book teaches, writes in bronze: the
%% structure, the links, the rules of theorem boxes, the learning coefficient. The regular theory,
%% the classical approximation that the book measures against, writes in slate: its predictions in
%% plots and the "regular answer" boxes. The ornaments are drawn from the subject. Under each
%% chapter title two rules cross transversally, a normal crossing. At the foot of each opening page
%% sits the Newton diagram of a loss from the chapter (for most chapters, its running model's; where
%% the model has no two-variable loss, an emblem): the exponents of the loss, the Newton boundary,
%% and the point where the diagonal meets it, which gives the learning coefficient. The title page
%% carries posterior draws of the model y = abx at its singular truth, which crowd onto the cross
%% ab = 0. The series class is not modified: its colour names are re-pointed to this palette and
%% its ornament macros are redefined here.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{singular}[2026/10/24 v1.0 volume style for Singular Learning Theory for the Rest of Us]

\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween,groupplots}
\usetikzlibrary{fadings}
\RequirePackage{siunitx}

