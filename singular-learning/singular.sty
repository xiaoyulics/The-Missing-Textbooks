% the chapter number in the margin, in a light bronze
\renewcommand*{\mb@chapnumfont}{\normalfont\fontsize{64}{64}\selectfont\color{singular!45}}

%------------------------------------------------------------------------------
% A normal crossing: a bronze rule crossed near its left end by a short slate rule. It replaces
% the series' wave rule under chapter titles and on part pages.
%------------------------------------------------------------------------------
\newlength{\slt@len}
\newcommand*{\slt@crossing}[1]{%
  \setlength{\slt@len}{#1}%
  \begin{tikzpicture}[x=1mm,y=1mm,baseline=0pt]
    \draw[singular!80,line width=0.5pt] (0,0) -- (\slt@len,0);
    \draw[regular!75,line width=0.5pt] (0,-1.05) -- (15,1.05);
  \end{tikzpicture}}
\renewcommand*{\mb@waverule}[1][]{%
  \par\noindent\makebox[\linewidth][l]{%
    \slt@crossing{\dimexpr\linewidth+\marginparsep+\marginparwidth\relax}}\par}

%------------------------------------------------------------------------------
% Newton diagrams
%   \newtondiagram{vertices}{t}{lambda}{K}
% draws the Newton diagram of a function K(a,b) of two variables: the lattice of exponents
% (i,j) of a^i b^j for 0 <= i,j <= 6, the Newton polyhedron (shaded), its boundary, the diagonal,
% and the point (t,t) where the diagonal meets the boundary; for a function that is
% non-degenerate on its Newton boundary the learning coefficient is lambda = 1/t.
%   vertices  the vertices of the Newton boundary in order, from top left to bottom right, as
%             i/j pairs: a^2 + b^4 has vertices 0/4,2/0; (ab)^2 has the single vertex 2/2
%   t         the diagonal's meeting point (a number pgfmath can evaluate, e.g. 4/3)
%   lambda    the learning coefficient as it should be printed, e.g. \tfrac34
%   K         the function as it should be printed (math mode), e.g. a^2+b^4
% \newtonfoot{...}{...}{...}{...} draws the same diagram at the foot of the current page, under
% the margin column; chapter openings and part pages call it.
%------------------------------------------------------------------------------
\newcommand*{\slt@u}{4.1}   % mm per unit exponent
\newcommand*{\slt@firsti}{0}
\newcommand*{\slt@lastj}{0}
\newcommand{\slt@newtondraw}[4]{%
  \foreach \slt@i in {0,...,6}{\foreach \slt@j in {0,...,6}{%
    \fill[muted!60] (\slt@i*\slt@u,\slt@j*\slt@u) circle (0.22);}}%
  \draw[muted!75,line width=0.3pt] (0,0) -- (6.55*\slt@u,0);
  \draw[muted!75,line width=0.3pt] (0,0) -- (0,6.55*\slt@u);
  \node[font=\sffamily\tiny,text=muted,anchor=west,inner sep=0.6pt] at (6.6*\slt@u,0) {$a$};
  \node[font=\sffamily\tiny,text=muted,anchor=south,inner sep=0.6pt] at (0,6.6*\slt@u) {$b$};
  % first and last vertices of the boundary
  \foreach \slt@i/\slt@j [count=\slt@c] in {#1}{%
    \ifnum\slt@c=1 \xdef\slt@firsti{\slt@i}\fi
    \xdef\slt@lastj{\slt@j}}%
  \fill[singular!13] (\slt@firsti*\slt@u,6.35*\slt@u)
    \foreach \slt@i/\slt@j in {#1}{ -- (\slt@i*\slt@u,\slt@j*\slt@u)}
    -- (6.35*\slt@u,\slt@lastj*\slt@u) -- (6.35*\slt@u,6.35*\slt@u) -- cycle;
  \draw[singular,line width=0.6pt,line join=round] (\slt@firsti*\slt@u,6.35*\slt@u)
    \foreach \slt@i/\slt@j in {#1}{ -- (\slt@i*\slt@u,\slt@j*\slt@u)}
    -- (6.35*\slt@u,\slt@lastj*\slt@u);
  \foreach \slt@i/\slt@j in {#1}{\fill[singular] (\slt@i*\slt@u,\slt@j*\slt@u) circle (0.5);}%
  \draw[regular!85,line width=0.45pt,dash pattern=on 1.2pt off 1pt] (0,0) -- (6.35*\slt@u,6.35*\slt@u);
  \fill[white] ({(#2)*\slt@u},{(#2)*\slt@u}) circle (0.95);
  \draw[singular,line width=0.65pt] ({(#2)*\slt@u},{(#2)*\slt@u}) circle (0.95);
  \ifslt@labelleft
    \node[font=\footnotesize,text=ink,anchor=east,inner sep=0pt,align=right] at (-2.6,3.2*\slt@u)
      {$K=#4$\\[0.5ex]${\color{singular}\lambda=#3}$};
  \else
    \node[font=\footnotesize,text=ink,anchor=north,inner sep=0pt] at (3.2*\slt@u,-2.4)
      {$K=#4$\quad${\color{singular}\lambda=#3}$};
  \fi}
\newif\ifslt@labelleft
\newcommand{\newtondiagram}[4]{%
  \begin{tikzpicture}[x=1mm,y=1mm,baseline=(current bounding box.center)]
    \slt@newtondraw{#1}{#2}{#3}{#4}
  \end{tikzpicture}}
% The foot diagram sits entirely in the bottom margin (the text block and the margin column end
% 31 mm above the bottom edge), so that it never meets a side note; its labels are on its left.
\newcommand*{\slt@footx}{163}  % mm from the left edge of the page
\newcommand*{\slt@footy}{6}    % mm from the bottom edge of the page
\newcommand{\newtonfoot}[4]{%
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=1mm]
    \begin{scope}[shift={(current page.south west)}]
      \begin{scope}[shift={(\slt@footx,\slt@footy)}]%
        \def\slt@u{3.2}\slt@labellefttrue\slt@newtondraw{#1}{#2}{#3}{#4}\end{scope}
    \end{scope}
  \end{tikzpicture}}
% \slt@ifblank{text}{if blank}{otherwise}, safe for arguments that contain mathematics
\newcommand{\slt@ifblank}[1]{\if\relax\detokenize{#1}\relax\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}
% the class calls \risingsea on part pages; here its argument is a Newton specification
% {vertices}{t}{lambda}{K} (or empty for none)
\renewcommand*{\risingsea}[1]{\slt@ifblank{#1}{}{\newtonfoot#1}}

%------------------------------------------------------------------------------
% Chapter openings
%   \sltchapter{Title}{Subtitle}{the model}{label}
% prints the title, the subtitle, "the model -- <model>", and the crossing rule; the chapter's
% Newton diagram follows on the next line of the source: \newtonfoot{vertices}{t}{lambda}{K}.
%   \specialchapter{Title}{Subtitle}{{vertices}{t}{lambda}{K}}   unnumbered (prologue, epilogue)
%   \appendixchapter{Title}{Subtitle}{label}                      the appendix (no diagram)
%   \casepart{Title}{Blurb}{{vertices}{t}{lambda}{K}}             part pages
%------------------------------------------------------------------------------
\newcommand*{\slt@chapmodel}{}
\newcommand*{\slt@tocsubtitle}[2]{%
  \par\nopagebreak\vspace{-0.15ex}{\leftskip=2.3em\small\itshape\color{muted}#1%
    \slt@ifblank{#2}{}{\unskip\nobreak\hfil\penalty50\hskip1.5em\hbox{}\nobreak\hfil
      \mbox{\upshape\color{singular}#2}{\parfillskip=0pt\finalhyphendemerits=0\par}}\par}\vspace{0.35ex}}
\newcommand{\slt@openerblock}[2]{%
  \vspace*{-0.2\baselineskip}%
  {\raggedright\large\itshape\color{muted}#1\par}%
  \slt@ifblank{#2}{}{%
    \vspace{0.55\baselineskip}%
    {\raggedright\small\textsc{\color{singular}the model}\enspace{\color{singular}\rule[0.32ex]{1.6em}{0.4pt}}\enspace #2\par}}%
  \vspace{0.5\baselineskip}%
  \mb@waverule
  \vspace{0.9\baselineskip}}
\newcommand{\sltchapter}[4]{%
  \chapter[head={#1},tocentry={#1}]{#1}\label{#4}%
  \addtocontents{toc}{\protect\slt@tocsubtitle{#2}{#3}}%
  \gdef\slt@chapmodel{#3}%
  \slt@openerblock{#2}{#3}%
  \@afterindentfalse\@afterheading}
\newcommand{\appendixchapter}[3]{%
  \chapter[head={#1},tocentry={#1}]{#1}\label{#3}%
  \addtocontents{toc}{\protect\mbtocsubtitle{#2}}%
  \gdef\slt@chapmodel{}%
  \slt@openerblock{#2}{}%
  \@afterindentfalse\@afterheading}
\renewcommand{\casechapter}[4]{\sltchapter{#1}{#2}{#3}{#4}}
\renewcommand{\specialchapter}[3]{%
  \addchap[head={#1},tocentry={#1}]{#1}%
  \addtocontents{toc}{\protect\mbtocsubtitle{#2}}%
  \gdef\slt@chapmodel{}%
  \risingsea{#3}%
  \slt@openerblock{#2}{}%
  \@afterindentfalse\@afterheading}
\renewcommand{\casepart}[3]{%
  \setpartpreamble[c][0.78\textwidth]{%
    \vspace{2.2\baselineskip}{\centering\slt@crossing{\linewidth}\par}\vspace{1.2\baselineskip}%
    {\normalfont\itshape\color{muted}\setlength{\parindent}{0pt}#2\par}%
    \risingsea{#3}}%
  \part{#1}}

% Figures and tables of an unnumbered chapter (the prologue, the epilogue) are numbered with a
% letter: \sltfloatprefix{P} after its heading, \sltfloatrestore at its end.
\newcommand*{\sltfloatprefix}[1]{%
  \global\let\slt@origthefigure\thefigure\global\let\slt@origthetable\thetable
  \global\let\slt@origtheHfigure\theHfigure\global\let\slt@origtheHtable\theHtable
  \setcounter{figure}{0}\setcounter{table}{0}%
  \gdef\thefigure{#1.\arabic{figure}}\gdef\thetable{#1.\arabic{table}}%
  \gdef\theHfigure{#1.\arabic{figure}}\gdef\theHtable{#1.\arabic{table}}}
\newcommand*{\sltfloatrestore}{%
  \global\let\thefigure\slt@origthefigure\global\let\thetable\slt@origthetable
  \global\let\theHfigure\slt@origtheHfigure\global\let\theHtable\slt@origtheHtable
  \setcounter{figure}{0}\setcounter{table}{0}}

%------------------------------------------------------------------------------
% Title page: posterior draws of y = abx at the singular truth a b = 0 (from
% figures/scripts/00-emblem.py, which writes figures/data/00-emblem.tex), over the cross ab = 0
% and two pairs of hyperbolas ab = +-c. The draws crowd onto the cross.
%------------------------------------------------------------------------------
\newcommand*{\slt@ecx}{142}   % mm: centre of the emblem
\newcommand*{\slt@ecy}{66}
\newcommand*{\slt@er}{52}     % mm per unit of a and b
\newcommand*{\slt@emblem}{%
  \begin{scope}[shift={(\slt@ecx,\slt@ecy)},x=\slt@er mm,y=\slt@er mm]
    \foreach \slt@c in {0.06,0.2}{%
      \foreach \slt@s in {1,-1}{%
        \draw[regular!35,line width=0.35pt,smooth,samples=60,domain=\slt@c:1]
          plot (\x,{\slt@s*\slt@c/\x}) plot (-\x,{-\slt@s*\slt@c/\x});}}
    \draw[regular!70,line width=0.45pt] (-1.04,0) -- (1.04,0);
    \draw[regular!70,line width=0.45pt] (0,-1.04) -- (0,1.04);
    \IfFileExists{figures/data/00-emblem.tex}{%
      \input{figures/data/00-emblem.tex}%
      \foreach \slt@a/\slt@b in \sltemblempoints {\fill[singular,opacity=0.6] (\slt@a,\slt@b) circle (0.0065);}}{}
    \node[font=\sffamily\scriptsize,text=regular,anchor=west] at (1.06,0) {$a$};
    \node[font=\sffamily\scriptsize,text=regular,anchor=south] at (0,1.06) {$b$};
  \end{scope}}
\renewcommand{\mbtitlepage}[4]{%
  \begin{titlepage}
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=1mm]
    \begin{scope}[shift={(current page.south west)}]\slt@emblem\end{scope}
  \end{tikzpicture}%
  \setlength{\parindent}{0pt}%
  \vspace*{18mm}
  {\large\scshape\color{singular}the missing textbooks\par}
  \vspace{14mm}
  \makebox[\textwidth][l]{\parbox{\dimexpr\textwidth+\marginparsep+\marginparwidth\relax}{\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000
    \fontsize{44}{50}\selectfont\color{ink}#1}}\par
  \vspace{7mm}
  {\LARGE\itshape\color{muted}#2\par}
  \vspace{20mm}
  {\Large #3\par}
  \vfill
  {\small\color{singulardeep}#4\par}
  \vspace*{6mm}
  \end{titlepage}}

%------------------------------------------------------------------------------
% Theorem-like environments of this volume (sharing the chapter's theorem counter)
%------------------------------------------------------------------------------
\theoremstyle{mbdefinition}
\mb@newsharedtheorem{assumption}{Assumption}
\tcolorboxenvironment{assumption}{mbdef}
\theoremstyle{mbremark}
\mb@newsharedtheorem{observation}{Observation}
\tcbset{slt@observation/.style={enhanced,breakable,colback=white,frame hidden,boxrule=0pt,arc=0pt,
    borderline west={0.6pt}{0pt}{singular!60},left=3.2mm,right=0mm,top=0.6mm,bottom=0.6mm,
    before skip=1.1ex plus 0.4ex,after skip=1.1ex plus 0.4ex}}
\tcolorboxenvironment{observation}{slt@observation}
\crefname{assumption}{Assumption}{Assumptions}
\crefname{observation}{Observation}{Observations}
\theoremstyle{mbplain}

% A heuristic derivation is an argument that is not a proof. It ends with a diamond instead of
% the tombstone, and \qedhere works inside it as in a proof.
\newcommand*{\slt@diamond}{\leavevmode\unskip\penalty9999 \hbox{}\nobreak\hfill\quad\hbox{$\Diamond$}}
\newenvironment{heuristic}[1][Heuristic derivation]{\par\pushQED{\slt@diamond}\normalfont
  \topsep5\p@\@plus5\p@\relax\trivlist\item[\hskip\labelsep\scshape #1.]\ignorespaces}
  {\popQED\endtrivlist\@endpefalse}

%------------------------------------------------------------------------------
% Signature boxes of this volume
%------------------------------------------------------------------------------
% \begin{regularanswer}[short title] ... \end{regularanswer}: what the regular theory predicts
\newtcolorbox{regularanswer}[1][]{enhanced,breakable,colback=regularwash,frame hidden,boxrule=0pt,arc=0pt,
  borderline west={1.3pt}{0pt}{regular},left=3.2mm,right=3mm,top=1.8mm,bottom=1.8mm,
  before skip=1.5ex plus 0.5ex,after skip=1.5ex plus 0.5ex,
  before upper={\textsc{\color{regular}the regular answer}\slt@ifblank{#1}{}{\enspace{\color{regular}\textperiodcentered}\enspace#1}%
    {\color{regular}.}\enspace}}

% \begin{computation}{Title} \step ... \step ... \end{computation}
% A computation by hand on a running example, written as numbered steps. Numbered
% "Computation N.k"; label comp:key:name.
\newcounter{computation}[chapter]
\renewcommand*{\thecomputation}{\thechapter.\arabic{computation}}
\crefname{computation}{Computation}{Computations}
\newcounter{slt@step}
\newcommand{\step}{\item}
\newenvironment{computation}[1]{%
  \refstepcounter{computation}\def\@currentlabelname{#1}%
  \begin{tcolorbox}[enhanced,breakable,colback=vellum,frame hidden,boxrule=0pt,arc=0pt,
    borderline north={0.5pt}{0pt}{singular!80},borderline south={0.5pt}{0pt}{singular!80},
    left=3.4mm,right=3.4mm,top=1.2mm,bottom=1.8mm,
    title={\textsc{computation \thecomputation}\enspace\textperiodcentered\enspace\textsc{#1}},
    fonttitle=\normalfont,coltitle=singular,colbacktitle=vellum,toptitle=1.4mm,bottomtitle=0.2mm,
    before skip=1.8ex,after skip=1.8ex]
  \begin{list}{\textcolor{singular}{\sffamily\small\arabic{slt@step}}}{\usecounter{slt@step}%
      \setlength{\labelwidth}{1.2em}\setlength{\labelsep}{0.7em}%
      \setlength{\leftmargin}{1.9em}\setlength{\itemsep}{0.6ex}%
      \setlength{\topsep}{0.4ex}\setlength{\parsep}{0.3ex}\setlength{\itemindent}{0pt}}}
  {\end{list}\end{tcolorbox}}

% \ledgercard{quantity}{regular theory}{singular theory}{running example}{measured}{rests on}
% The end-of-chapter card: the chapter's quantity, what the regular and the singular theory say
% about it, its value in the running example, what the scripts measured, and the assumptions.
\newcommand{\slt@cardrow}[2]{\par\noindent\hangindent=9.6em\hangafter=1
  \makebox[9.6em][l]{#1}\ignorespaces#2\par\vspace{0.55ex}}
\newcommand{\ledgercard}[6]{%
  \begin{tcolorbox}[enhanced,breakable,colback=white,colframe=singular!50,boxrule=0.5pt,arc=0pt,
    left=3mm,right=3mm,top=1.9mm,bottom=1.2mm,
    title={\textsc{ledger}\ifx\slt@chapmodel\@empty\else\enspace\textperiodcentered\enspace\slt@chapmodel\fi},
    fonttitle=\normalfont,coltitle=white,colbacktitle=singular,toptitle=1mm,bottomtitle=1mm,
    before skip=1.8ex,after skip=1.8ex,fontupper=\small]
  \slt@cardrow{\textsc{\color{singular}quantity}}{#1}%
  \slt@cardrow{\textsc{\color{regular}regular theory}}{#2}%
  \slt@cardrow{\textsc{\color{singular}singular theory}}{#3}%
  \slt@cardrow{\textsc{\color{singular}running example}}{#4}%
  \slt@cardrow{\textsc{\color{singular}measured}}{#5}%
  \slt@cardrow{\textsc{\color{muted}rests on}}{#6}%
  \end{tcolorbox}}

%------------------------------------------------------------------------------
% Plots: measurements against the singular and the regular predictions
%------------------------------------------------------------------------------
\pgfplotscreateplotcyclelist{sltcycle}{%
  {singular,line width=1.0pt},%
  {regular,line width=1.0pt,dashed},%
  {singular!55,line width=1.0pt,densely dotted},%
  {muted,line width=0.9pt,dashdotted}}
\pgfplotsset{
  splot/.style={width=0.92\linewidth,height=0.58\linewidth,
    axis line style={muted!80},tick style={muted!80},major tick length=2.5pt,
    every tick label/.append style={font=\footnotesize,text=ink},
    label style={font=\small,text=ink},title style={font=\small},
    legend style={draw=none,fill=white,fill opacity=0.85,text opacity=1,font=\footnotesize},
    legend cell align=left,cycle list name=sltcycle,scaled ticks=false,
    tick label style={/pgf/number format/fixed}},
  % predictions: the singular theory (bronze, solid) and the regular theory (slate, dashed)
  theory/.style={singular,line width=1.0pt,no marks},
  theory2/.style={singular!55,line width=0.9pt,densely dotted,no marks},
  regularpred/.style={regular,line width=0.9pt,dash pattern=on 3pt off 2pt,no marks},
  % measurements: filled ink circles; hollow bronze circles and slate squares for second series
  measured/.style={only marks,mark=*,mark size=1.6pt,color=ink,
    mark options={fill=ink,draw=white,line width=0.2pt}},
  measured2/.style={only marks,mark=o,mark size=1.7pt,color=singular,
    mark options={line width=0.6pt,fill=white}},
  measured3/.style={only marks,mark=square,mark size=1.5pt,color=regular,
    mark options={line width=0.6pt,fill=white}},
  ebars/.style={error bars/y dir=both,error bars/y explicit,
    error bars/error bar style={line width=0.5pt},
    error bars/error mark options={rotate=90,mark size=1.6pt,line width=0.5pt}},
  guide/.style={muted,line width=0.5pt,densely dashed,no marks},
  band/.style={fill=singular!12,draw=none},
  % posterior draws in a scatter plot
  draws/.style={only marks,mark=*,mark size=0.35pt,color=singular,mark options={draw=none,fill opacity=0.5}},
}

