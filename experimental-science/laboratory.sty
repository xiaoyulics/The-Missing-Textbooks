%------------------------------------------------------------------------------
% Theorem-like environments of this volume (sharing the chapter's theorem counter)
%------------------------------------------------------------------------------
\theoremstyle{mbdefinition}
\mb@newsharedtheorem{hypothesis}{Hypothesis}
\mb@newsharedtheorem{assumption}{Assumption}
\tcolorboxenvironment{hypothesis}{mbdef}
\tcolorboxenvironment{assumption}{mbdef}
\theoremstyle{mbremark}
\mb@newsharedtheorem{finding}{Finding}
\tcbset{lab@finding/.style={enhanced,breakable,colback=white,frame hidden,boxrule=0pt,arc=0pt,
    borderline west={0.6pt}{0pt}{inkblue!65},left=3.2mm,right=0mm,top=0.6mm,bottom=0.6mm,
    before skip=1.1ex plus 0.4ex,after skip=1.1ex plus 0.4ex}}
\tcolorboxenvironment{finding}{lab@finding}
\crefname{hypothesis}{Hypothesis}{Hypotheses}
\crefname{assumption}{Assumption}{Assumptions}
\crefname{finding}{Finding}{Findings}
\theoremstyle{mbplain}

% A heuristic derivation is an argument that is not a proof. It ends with a diamond
% instead of the tombstone, and \qedhere works inside it as in a proof.
\newcommand*{\lab@diamond}{\leavevmode\unskip\penalty9999 \hbox{}\nobreak\hfill\quad\hbox{$\Diamond$}}
\newenvironment{heuristic}[1][Heuristic derivation]{\par\pushQED{\lab@diamond}\normalfont
  \topsep5\p@\@plus5\p@\relax\trivlist\item[\hskip\labelsep\scshape #1.]\ignorespaces}
  {\popQED\endtrivlist\@endpefalse}

%------------------------------------------------------------------------------
% Record boxes of this volume
%------------------------------------------------------------------------------
% \begin{experiment}[whose experiment] \field{question}{...} \field{treatment}{...} ... \end{experiment}
% A record sheet: one row per field, hairlines between rows.
\newif\iflab@firstfield
\newcommand{\lab@field}[2]{%
  \iflab@firstfield\global\lab@firstfieldfalse\else
    \par\vspace{0.5ex}{\color{paperline}\hrule height 0.3pt}\vspace{0.6ex}\fi
  \noindent\hangindent=7.2em\hangafter=1
  \makebox[7.2em][l]{\textsc{\textcolor{rubric}{#1}}}\ignorespaces#2\par}
\newenvironment{experiment}[1][]{%
  \begin{tcolorbox}[enhanced,breakable,colback=white,colframe=paperline,boxrule=0.5pt,arc=0pt,
    left=3mm,right=3mm,top=1.8mm,bottom=1.6mm,
    title={\textsc{experimental design}\Ifstr{#1}{}{}{\enspace\textperiodcentered\enspace\textsc{#1}}},
    fonttitle=\normalfont,coltitle=rubric,colbacktitle=paper,toptitle=0.9mm,bottomtitle=0.9mm,
    before skip=1.6ex,after skip=1.6ex,fontupper=\small]%
  \global\lab@firstfieldtrue\let\field\lab@field\setlength{\parskip}{0pt}}
  {\end{tcolorbox}}

% \begin{verdict}{reversed} ... \end{verdict}: closes the post-mortem. The verdict word is
% stamped in the margin beside the box. Verdict words: reversed, vanishes, confounded,
% artifact, narrowed, mechanism replaced, holds, open.
\newcommand*{\lab@stamp}[1]{%
  \begin{tikzpicture}[rotate=-7,transform shape]
    \node[draw=rubric,line width=1pt,rounded corners=1.8pt,inner xsep=2.8mm,inner ysep=1.6mm,
      text=rubric,font=\large\scshape] (s) {#1};
    \draw[rubric,line width=0.4pt,rounded corners=1.1pt] ([shift={(0.65mm,0.65mm)}]s.south west)
      rectangle ([shift={(-0.65mm,-0.65mm)}]s.north east);
  \end{tikzpicture}}
\newenvironment{verdict}[1]{%
  \lab@recordverdict{#1}%
  \begin{tcolorbox}[enhanced,breakable,colback=paper,frame hidden,boxrule=0pt,arc=0pt,
    borderline north={0.8pt}{0pt}{rubric},borderline south={0.8pt}{0pt}{rubric},
    left=3.2mm,right=3.2mm,top=2.2mm,bottom=2.2mm,before skip=2ex,after skip=2ex,
    overlay unbroken and first={\node[anchor=north,inner sep=0pt] at
      ([xshift=\marginparsep+0.5\marginparwidth,yshift=-1mm]frame.north east) {\lab@stamp{#1}};},
    before upper={\textsc{\color{rubric}verdict.}\enspace}]}
  {\end{tcolorbox}}

% \begin{protocol}{Comparing two optimizers} \item ... \end{protocol}: a numbered procedure
% with check boxes, closing each chapter.
\newcounter{protocol}[chapter]
\renewcommand*{\theprotocol}{\thechapter.\arabic{protocol}}
\crefname{protocol}{Protocol}{Protocols}
\DeclareRobustCommand*{\lab@checkbox}{\raisebox{0.05ex}{\tikz{\draw[rubric,line width=0.55pt] (0,0) rectangle (0.62em,0.62em);}}}
\newenvironment{protocol}[1]{%
  \refstepcounter{protocol}%
  \begin{tcolorbox}[enhanced,breakable,colback=paper,colframe=rubric,boxrule=0pt,
    toprule=0pt,bottomrule=0pt,leftrule=0pt,rightrule=0pt,arc=0pt,
    left=4mm,right=4mm,top=2.4mm,bottom=2.4mm,
    title={\textsc{protocol \theprotocol}\enspace\textperiodcentered\enspace\textsc{#1}},
    fonttitle=\normalfont,coltitle=white,colbacktitle=rubric,toptitle=1.1mm,bottomtitle=1.1mm,
    before skip=1.8ex,after skip=1.8ex]
  \begin{enumerate}[label={\lab@checkbox},leftmargin=1.7em,labelsep=0.75em,itemsep=0.55ex,topsep=0.2ex]}
  {\end{enumerate}\end{tcolorbox}}

% \begin{lab}{Budget curves for two optimizers}{figures/scripts/03-budgets-curves.py} ... \end{lab}
% A lab sheet on engineering paper: what to run, what to predict first, what to look for.
\newcounter{lab}[chapter]
\renewcommand*{\thelab}{\thechapter.\arabic{lab}}
\crefname{lab}{Lab}{Labs}
% #1 = upper right corner of the area below the title
\newcommand*{\lab@sheetgrid}[1]{%
  \begin{scope}
    \clip (interior.south west) rectangle (#1);
    \begin{scope}[shift={(interior.south west)}]
      \draw[gridline!20,line width=0.22pt,step=5mm] (0,0) grid (300mm,300mm);
    \end{scope}
  \end{scope}}
% #2 is the base name of the script in figures/scripts, printed in the margin
\newenvironment{lab}[2]{%
  \refstepcounter{lab}%
  \begin{tcolorbox}[enhanced,breakable,colback=white,colframe=gridline!55,boxrule=0.4pt,arc=0pt,
    left=3.4mm,right=3.4mm,top=2mm,bottom=2mm,
    underlay unbroken and first={\lab@sheetgrid{title.south east}},
    underlay middle and last={\lab@sheetgrid{interior.north east}},
    title={\textsc{lab \thelab}\enspace\textperiodcentered\enspace\textsc{#1}},
    fonttitle=\normalfont,coltitle=rubric,colbacktitle=paper,toptitle=0.9mm,bottomtitle=0.9mm,
    titlerule=0.4pt,
    overlay unbroken and first={\node[anchor=north west,inner sep=0pt,text width=\marginparwidth,
      align=left,font=\footnotesize] at ([xshift=\marginparsep,yshift=-1.3mm]frame.north east)
      {\textsc{\color{rubric}script}\\[0.3ex]{\ttfamily\color{inkblue}#2.py}};},
    before skip=1.8ex,after skip=1.8ex]}
  {\end{tcolorbox}}
\newcommand{\labpart}[1]{\par\smallskip\noindent{\scshape\color{rubric}#1.}\enspace}

%------------------------------------------------------------------------------
% Plots: pgfplots on graph paper
%------------------------------------------------------------------------------
\pgfplotscreateplotcyclelist{labcycle}{%
  {inkblue,line width=1.0pt},%
  {rubric,line width=1.0pt,dashed},%
  {black!55,line width=0.9pt,densely dotted},%
  {paperline!60!black,line width=0.9pt,dashdotted}}
\pgfplotsset{
  lplot/.style={width=0.92\linewidth,height=0.58\linewidth,
    grid=both,minor tick num=4,
    major grid style={gridline!38,line width=0.32pt},minor grid style={gridline!14,line width=0.2pt},
    axis line style={gridline!70,line width=0.4pt},tick style={draw=none},
    every tick label/.append style={font=\footnotesize,text=ink},
    label style={font=\small,text=ink},title style={font=\small},
    legend style={draw=none,fill=white,fill opacity=0.9,text opacity=1,font=\footnotesize},
    legend cell align=left,cycle list name=labcycle,scaled ticks=false,
    tick label style={/pgf/number format/fixed}},
  % log axes: use \begin{loglogaxis}[lplot,lloglog] (or semilogxaxis / semilogyaxis); pgfplots
  % accepts xmode and ymode only as direct options of the axis, never inside a style
  lloglog/.style={minor tick num=0,minor grid style={gridline!16,line width=0.2pt}},
  % individual runs, their mean with error bars, a fitted curve and its extrapolation
  run/.style={only marks,mark=o,mark size=1.15pt,color=inkblue!70,mark options={line width=0.35pt,fill=white}},
  mean/.style={only marks,mark=*,mark size=1.6pt,color=inkblue,mark options={fill=inkblue,draw=white,line width=0.2pt}},
  ebars/.style={error bars/y dir=both,error bars/y explicit,
    error bars/error bar style={inkblue,line width=0.5pt},
    error bars/error mark options={inkblue,rotate=90,mark size=1.7pt,line width=0.5pt}},
  xebars/.style={error bars/x dir=both,error bars/x explicit,
    error bars/error bar style={inkblue,line width=0.5pt},
    error bars/error mark options={inkblue,mark size=1.7pt,line width=0.5pt}},
  fit/.style={rubric,line width=1.0pt,no marks},
  extrapolation/.style={rubric,line width=0.9pt,dash pattern=on 3pt off 2pt,no marks},
  ciband/.style={fill=rubric!11,draw=none},
  reference/.style={black!55,line width=0.5pt,densely dashed,no marks},
  % the same marks in vermilion, for the second arm of a comparison
  runB/.style={only marks,mark=o,mark size=1.15pt,color=rubric!75,mark options={line width=0.35pt,fill=white}},
  meanB/.style={only marks,mark=square*,mark size=1.45pt,color=rubric,mark options={fill=rubric,draw=white,line width=0.2pt}},
  ebarsB/.style={error bars/y dir=both,error bars/y explicit,
    error bars/error bar style={rubric,line width=0.5pt},
    error bars/error mark options={rubric,rotate=90,mark size=1.7pt,line width=0.5pt}},
  % two arms of a comparison
  armA/.style={inkblue,line width=1.0pt,mark=*,mark size=1.4pt,mark options={fill=inkblue,draw=white,line width=0.2pt}},
  armB/.style={rubric,line width=1.0pt,mark=square*,mark size=1.3pt,mark options={fill=rubric,draw=white,line width=0.2pt}},
}

