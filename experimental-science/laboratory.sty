%% laboratory.sty -- volume style for "Deep Learning as an Experimental Science"
%% (The Missing Textbooks, volume 4). Loaded after missingbook.cls by main.tex and by
%% tools/build_chapter.sh. Chapters must not load packages of their own.
%%
%% The design is a laboratory notebook. Structure is rubricated in a graph-paper vermilion,
%% measurements and links are in a blue-black ink, record boxes sit on a cream tint, and
%% the ornaments are graph paper: log-log paper with a fitted scaling law on the title
%% page, millimetre paper with a running mean at the foot of each chapter opening, and a
%% ruler under each chapter title. The series class is not modified: its colour names
%% are re-pointed to this palette and its ornament macros are redefined here.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{laboratory}[2026/10/17 v1.0 volume style for Deep Learning as an Experimental Science]

\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween,groupplots}
\usetikzlibrary{fadings}
\RequirePackage[scale=0.86]{sourcecodepro}
\RequirePackage{siunitx}
\sisetup{uncertainty-mode=separate,group-minimum-digits=5}

%------------------------------------------------------------------------------
% Palette
%------------------------------------------------------------------------------
\definecolor{rubric}{RGB}{176,58,36}       % vermilion: section numbers, labels, rules
\definecolor{rubricdeep}{RGB}{116,36,22}   % part titles, imprint
\definecolor{inkblue}{RGB}{28,54,94}       % measurements, links, rules of theorem boxes
\definecolor{gridline}{RGB}{222,124,84}    % graph-paper lines; always used as a tint
\definecolor{paper}{RGB}{250,247,240}      % cream tint of record boxes
\definecolor{paperline}{RGB}{214,198,170}  % rules of record boxes
\definecolor{inkwash}{RGB}{237,241,247}    % pale ink tint of theorem boxes
% the series class draws with these names
\colorlet{sea}{rubric}
\colorlet{seadeep}{rubricdeep}
\colorlet{seafoam}{inkwash}
\colorlet{seamist}{gridline!22}
\colorlet{sand}{paper}
\colorlet{sandline}{paperline}
\hypersetup{linkcolor=inkblue,citecolor=inkblue,urlcolor=inkblue}

% theorems: a pale ink wash with an ink rule (definitions keep the cream box of the class)
\tcbset{mbthm/.style={enhanced,breakable,colback=inkwash,frame hidden,boxrule=0pt,arc=0pt,
    borderline west={1.3pt}{0pt}{inkblue},left=3.2mm,right=3mm,top=1.6mm,bottom=1.6mm,
    before skip=1.3ex plus 0.5ex,after skip=1.3ex plus 0.5ex}}

% the chapter number in the margin, in the colour of the graph paper
\renewcommand*{\mb@chapnumfont}{\normalfont\fontsize{64}{64}\selectfont\color{gridline!80}}

%------------------------------------------------------------------------------
% The ruler: a millimetre scale across text block and margin column. It replaces
% the series' wave rule under chapter titles and on part pages.
%------------------------------------------------------------------------------
% \lab@ruler{colour}{length}: a ruler of the given length, in whole millimetres
\newlength{\lab@len}
\newcommand*{\lab@ruler}[2]{%
  \setlength{\lab@len}{#2}%
  \pgfmathtruncatemacro{\lab@n}{\lab@len/(1mm)}%
  \begin{tikzpicture}[x=1mm,y=1mm]
    \draw[#1,line width=0.45pt] (0,0) -- (\lab@n,0);
    \foreach \i in {0,...,\lab@n}{%
      \pgfmathsetmacro{\lab@h}{ifthenelse(mod(\i,10)==0,1.9,ifthenelse(mod(\i,5)==0,1.25,0.7))}%
      \draw[#1,line width=0.28pt] (\i,0) -- (\i,-\lab@h);}
  \end{tikzpicture}}
\renewcommand*{\mb@waverule}[1][rubric!75]{%
  \par\noindent\makebox[\linewidth][l]{%
    \lab@ruler{#1}{\dimexpr\linewidth+\marginparsep+\marginparwidth\relax}}\par}
% part pages: the ruler spans the blurb, and the foot of the page is blank graph paper
\renewcommand{\casepart}[3]{%
  \setpartpreamble[c][0.78\textwidth]{%
    \vspace{2.2\baselineskip}{\centering\lab@ruler{rubric!60}{\linewidth}\par}\vspace{1.2\baselineskip}%
    {\normalfont\itshape\color{muted}\setlength{\parindent}{0pt}#2\par}%
    \risingsea{#3}}%
  \part{#1}}

%------------------------------------------------------------------------------
% The foot of an opening page: millimetre paper fading upwards, and the record of
% repeated measurement. Chapter k shows the first k of sixteen runs (hollow dots), their
% running mean (filled) and a 95% t-interval for the mean. Chapter 1 has one run and no
% interval. The runs are sixteen standard normal draws (NumPy default_rng, seed 3407);
% see figures/scripts/00-emblem.py. Entries: j / run / running mean / half-width, in
% units of the standard deviation.
%------------------------------------------------------------------------------
\tikzfading[name=lab@coverfade,top color=transparent!0,bottom color=transparent!100]
\newcommand*{\lab@runlist}{%
  1/2.814/2.814/0.000,2/-1.534/0.640/27.622,3/0.551/0.611/5.402,4/-0.328/0.376/2.922,%
  5/-0.181/0.265/1.999,6/-0.371/0.159/1.535,7/-0.046/0.129/1.237,8/-3.019/-0.264/1.392,%
  9/1.458/-0.073/1.276,10/0.471/-0.018/1.126,11/-0.466/-0.059/1.008,12/-1.309/-0.163/0.937,%
  13/-0.048/-0.154/0.854,14/1.781/-0.016/0.839,15/-0.568/-0.053/0.779,16/0.772/-0.001/0.732}
\newcommand*{\lab@bandheight}{27}  % mm
\newcommand*{\lab@zero}{11}        % mm: height of the true value
\newcommand*{\lab@sd}{3}           % mm per standard deviation
\newcommand*{\lab@step}{11.4}      % mm between runs
% #1 = number of runs to show (0 to 16)
\newcommand*{\lab@band}[1]{%
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=1mm]
    \begin{scope}[shift={(current page.south west)}]
      \begin{scope}[shift={(4,0)}]
        \draw[gridline!13,line width=0.15pt,step=1] (-4,0) grid (206,\lab@bandheight);
        \draw[gridline!25,line width=0.25pt,step=5] (-4,0) grid (206,\lab@bandheight);
        \draw[gridline!40,line width=0.35pt,step=10] (-4,0) grid (206,\lab@bandheight);
      \end{scope}
      \fill[white,path fading=lab@coverfade] (0,\lab@zero+2) rectangle (210,\lab@bandheight+0.2);
      \draw[inkblue!45,line width=0.4pt,dash pattern=on 2.2pt off 1.6pt] (0,\lab@zero) -- (210,\lab@zero);
      \foreach \j/\y/\m/\h in \lab@runlist {%
        \ifnum\j>#1\relax\else
          \pgfmathsetmacro{\lab@x}{24+(\j-1)*\lab@step}%
          \pgfmathsetmacro{\lab@ym}{\lab@zero+\lab@sd*\m}%
          \ifnum\j>1\relax
            \pgfmathsetmacro{\lab@lo}{max(\lab@zero+\lab@sd*(\m-\h),1.0)}%
            \pgfmathsetmacro{\lab@hi}{min(\lab@zero+\lab@sd*(\m+\h),\lab@bandheight-1.5)}%
            \draw[inkblue,line width=0.45pt] (\lab@x,\lab@lo) -- (\lab@x,\lab@hi);
            \pgfmathtruncatemacro{\lab@clip}{(\lab@zero+\lab@sd*(\m-\h)<1.0)?1:0}%
            \ifnum\lab@clip=1\relax
              \fill[inkblue] (\lab@x,\lab@lo-0.6) -- ++(-0.55,1.15) -- ++(1.1,0) -- cycle;
            \else\draw[inkblue,line width=0.45pt] (\lab@x-0.7,\lab@lo) -- ++(1.4,0);\fi
            \pgfmathtruncatemacro{\lab@clip}{(\lab@zero+\lab@sd*(\m+\h)>\lab@bandheight-1.5)?1:0}%
            \ifnum\lab@clip=1\relax
              \fill[inkblue] (\lab@x,\lab@hi+0.6) -- ++(-0.55,-1.15) -- ++(1.1,0) -- cycle;
            \else\draw[inkblue,line width=0.45pt] (\lab@x-0.7,\lab@hi) -- ++(1.4,0);\fi
            \draw[inkblue!70,line width=0.35pt,fill=white] (\lab@x,\lab@zero+\lab@sd*\y) circle (0.5);
          \fi
          \fill[inkblue] (\lab@x,\lab@ym) circle (0.62);
        \fi}
    \end{scope}
  \end{tikzpicture}}
% the class calls \risingsea on part pages and special chapters; here its argument is
% the number of runs to show
\renewcommand*{\risingsea}[1]{\lab@band{#1}}

%------------------------------------------------------------------------------
% Chapter openings
%   \labchapter{Title}{Subtitle}{The claim}{Its source}{The verdict}{label}
% The claim is set in quotation marks; its source goes in the margin beside it.
%------------------------------------------------------------------------------
\newlength{\lab@tagwidth}
\setlength{\lab@tagwidth}{6.3em}
\newcommand{\lab@tagrow}[3]{%
  \par\noindent\makebox[\linewidth][l]{%
    \parbox[t]{\linewidth}{\raggedright\hangindent=\lab@tagwidth\hangafter=1
      \makebox[\lab@tagwidth][l]{\textsc{\color{rubric}#1}}#2}%
    \hspace*{\marginparsep}%
    \parbox[t]{\marginparwidth}{\raggedright\footnotesize\itshape\leavevmode\color{muted}#3}}\par}
\newcommand{\lab@openerblock}[4]{%
  \vspace*{-0.2\baselineskip}%
  {\raggedright\large\itshape\color{muted}#1\par}%
  \vspace{0.75\baselineskip}%
  \lab@tagrow{the claim}{\itshape\enquote{#2}}{#3}%
  \vspace{0.3\baselineskip}%
  \lab@tagrow{the verdict}{#4}{}%
  \vspace{0.55\baselineskip}%
  \mb@waverule
  \vspace{0.9\baselineskip}}
% The verdict box of a chapter records its word in the .aux file; on the next run the
% table of contents prints it, in small capitals, beside the chapter's subtitle.
\newcommand*{\lab@setverdict}[2]{\expandafter\gdef\csname lab@verdict@#1\endcsname{#2}}
\newcommand*{\lab@recordverdict}[1]{%
  \if@filesw\immediate\write\@auxout{\string\lab@setverdict{\thechapter}{#1}}\fi}
\newcommand*{\lab@tocsubtitle}[2]{%
  \par\nopagebreak\vspace{-0.15ex}{\leftskip=2.3em\small\itshape\color{muted}#1%
    \ifcsname lab@verdict@#2\endcsname\hfill
      {\upshape\scshape\color{rubric}\csname lab@verdict@#2\endcsname}\fi\par}\vspace{0.35ex}}
\newcommand{\labchapter}[6]{%
  \chapter[head={#1},tocentry={#1}]{#1}\label{#6}%
  \addtocontents{toc}{\protect\lab@tocsubtitle{#2}{\thechapter}}%
  \lab@band{\value{chapter}}%
  \lab@openerblock{#2}{#3}{#4}{#5}%
  \@afterindentfalse\@afterheading}

% An appendix chapter has no claim and no verdict: \labappendix{Title}{Subtitle}{label}.
% Its foot shows every run. The class's \casechapter is redirected to the same band.
\newcommand{\labappendix}[3]{%
  \chapter[head={#1},tocentry={#1}]{#1}\label{#3}%
  \addtocontents{toc}{\protect\mbtocsubtitle{#2}}%
  \lab@band{16}%
  \mb@subtitleblock{#2}{}%
  \@afterindentfalse\@afterheading}
\renewcommand{\casechapter}[4]{%
  \chapter[head={#1},tocentry={#1}]{#1}\label{#4}%
  \addtocontents{toc}{\protect\mbtocsubtitle{#2}}%
  \lab@band{\value{chapter}}%
  \mb@subtitleblock{#2}{#3}%
  \@afterindentfalse\@afterheading}

