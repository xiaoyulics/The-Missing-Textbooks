\newcommand*{\vi@pitch}{3.1}     % mm between bits
\newcommand*{\vi@fieldx}{7.35}   % mm: centre of column 0
\newcommand*{\vi@fieldy}{5.0}    % mm: centre of row 31 (the bottom row)
\newcount\vi@col
\newcount\vi@row
\def\vi@eachbit#1{%
  \ifx#1\relax\else
    \node[inner sep=0pt,text=prover!58] at ({\vi@fieldx+\vi@pitch*\the\vi@col},{\vi@fieldy+\vi@pitch*(31-\the\vi@row)}) {#1};%
    \global\advance\vi@col by 1\relax
    \expandafter\vi@eachbit\fi}
\newcommand*{\vi@codefield}{%
  \global\vi@row=0\relax
  \begin{scope}[font=\fontsize{6.4}{6.4}\ttfamily]
  \foreach \vi@r in \vi@coderows {%
    \global\vi@col=0\relax
    \expandafter\vi@eachbit\vi@r\relax
    \global\advance\vi@row by 1\relax}%
  \end{scope}}
\renewcommand{\mbtitlepage}[4]{%
  \begin{titlepage}
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=1mm]
    \begin{scope}[shift={(current page.south west)}]
      \vi@codefield
      \fill[white,path fading=vi@coverfade] (0,46) rectangle (210,104);
      % rows 11, 17, 24 and columns 52, 12, 58: x = 7.35 + 3.1 col, y = 5 + 3.1 (31 - row)
      \foreach \vi@ax/\vi@ay/\vi@bx/\vi@by in {168.55/67.0/44.55/48.4,44.55/48.4/187.15/26.7,187.15/26.7/168.55/67.0}{%
        \draw[verifier!80,line width=0.35pt,shorten <=2.05mm,shorten >=2.05mm] (\vi@ax,\vi@ay) -- (\vi@bx,\vi@by);}
      \foreach \vi@ax/\vi@ay/\vi@bit in {168.55/67.0/1,44.55/48.4/1,187.15/26.7/0}{%
        \fill[white] (\vi@ax,\vi@ay) circle (1.95);
        \draw[verifier,line width=0.7pt] (\vi@ax,\vi@ay) circle (1.95);
        \node[inner sep=0pt,text=verifier,font=\fontsize{7.4}{7.4}\ttfamily\bfseries] at (\vi@ax,\vi@ay) {\vi@bit};}
    \end{scope}
  \end{tikzpicture}%
  \setlength{\parindent}{0pt}%
  \vspace*{18mm}
  {\large\scshape\color{prover}the missing textbooks\par}
  \vspace{14mm}
  \makebox[\textwidth][l]{\parbox{\dimexpr\textwidth+\marginparsep+\marginparwidth\relax}{\raggedright\hyphenpenalty=10000\exhyphenpenalty=10000
    \fontsize{44}{50}\selectfont\color{ink}#1}}\par
  \vspace{7mm}
  {\LARGE\itshape\color{muted}#2\par}
  \vspace{20mm}
  {\Large #3\par}
  \vfill
  {\small\color{proverdeep}#4\par}
  \vspace*{68mm}
  \end{titlepage}}

%------------------------------------------------------------------------------
% Theorem-like environments of this volume (sharing the chapter's theorem counter)
%------------------------------------------------------------------------------
\theoremstyle{mbdefinition}
\mb@newsharedtheorem{assumption}{Assumption}
\tcolorboxenvironment{assumption}{mbdef}
\theoremstyle{mbremark}
\mb@newsharedtheorem{observation}{Observation}
\tcbset{vi@observation/.style={enhanced,breakable,colback=white,frame hidden,boxrule=0pt,arc=0pt,
    borderline west={0.6pt}{0pt}{prover!60},left=3.2mm,right=0mm,top=0.6mm,bottom=0.6mm,
    before skip=1.1ex plus 0.4ex,after skip=1.1ex plus 0.4ex}}
\tcolorboxenvironment{observation}{vi@observation}
\crefname{assumption}{Assumption}{Assumptions}
\crefname{observation}{Observation}{Observations}
\theoremstyle{mbplain}

% A heuristic derivation is an argument that is not a proof. It ends with a diamond instead of
% the tombstone, and \qedhere works inside it as in a proof.
\newcommand*{\vi@diamond}{\leavevmode\unskip\penalty9999 \hbox{}\nobreak\hfill\quad\hbox{$\Diamond$}}
\newenvironment{heuristic}[1][Heuristic derivation]{\par\pushQED{\vi@diamond}\normalfont
  \topsep5\p@\@plus5\p@\relax\trivlist\item[\hskip\labelsep\scshape #1.]\ignorespaces}
  {\popQED\endtrivlist\@endpefalse}

%------------------------------------------------------------------------------
% Parties. A party's name is a sans-serif letter, coloured by its role in protocol boxes:
% V (verifier, judge) ochre; P, P_1, A (prover, first debater) indigo; B (second debater) teal;
% P_2 (a second prover) teal; H, O (a human judge consulted as an oracle) sage. Inside \item[...]
% an optional colour must be braced: \item[{\msg[oracle]{X}{V}}].
%------------------------------------------------------------------------------
\newcommand*{\V}{\mathsf{V}}
\newcommand*{\Prov}{\mathsf{P}}
\newcommand*{\party}[1]{\mathsf{#1}}
\def\vi@first#1#2\@nil{#1}
\newcommand*{\vi@pc@V}{verifier}
\newcommand*{\vi@pc@J}{verifier}
\newcommand*{\vi@pc@P}{prover}
\newcommand*{\vi@pc@A}{prover}
\newcommand*{\vi@pc@B}{proverB}
\newcommand*{\vi@pc@H}{oracle}
\newcommand*{\vi@pc@O}{oracle}
\expandafter\def\csname vi@pc@P_2\endcsname{proverB}
\expandafter\def\csname vi@pc@P_{2}\endcsname{proverB}
% the colour of a party: by its full name if listed (P_2), else by its first letter, else indigo
\newcommand*{\vi@partycolor}[1]{%
  \ifcsname vi@pc@\detokenize{#1}\endcsname\csname vi@pc@\detokenize{#1}\endcsname
  \else\ifcsname vi@pc@\vi@first#1\@nil\endcsname\csname vi@pc@\vi@first#1\@nil\endcsname\else prover\fi\fi}
\newcommand*{\vi@partyname}[2]{{\color{#1}\ensuremath{\mathsf{#2}}}}
% labels of protocol steps: \msg{P}{V} prints "P -> V" in the sender's colour; \act{V} prints "V"
\NewDocumentCommand{\msg}{o m m}{%
  \IfNoValueTF{#1}{\edef\vi@c{\vi@partycolor{#2}}}{\def\vi@c{#1}}%
  {\small\vi@partyname{\vi@c}{#2}\,{\color{muted}$\to$}\,\vi@partyname{\vi@partycolor{#3}}{#3}}}
\NewDocumentCommand{\act}{o m}{%
  \IfNoValueTF{#1}{\edef\vi@c{\vi@partycolor{#2}}}{\def\vi@c{#1}}%
  {\small\vi@partyname{\vi@c}{#2}}}

%------------------------------------------------------------------------------
% Signature boxes of this volume
%------------------------------------------------------------------------------
% \begin{oversight}[short title] ... \end{oversight}: the oversight problem that opens a chapter
\newtcolorbox{oversight}[1][]{enhanced,breakable,colback=ochrewash,frame hidden,boxrule=0pt,arc=0pt,
  borderline west={1.3pt}{0pt}{verifier},left=3.2mm,right=3mm,top=1.8mm,bottom=1.8mm,
  before skip=1.5ex plus 0.5ex,after skip=1.5ex plus 0.5ex,
  before upper={\textsc{\color{verifier}the oversight problem}\Ifstr{#1}{}{}{\enspace{\color{verifier}\textperiodcentered}\enspace#1}%
    {\color{verifier}.}\enspace}}

% \begin{protocol}{Name} \item[\msg{P}{V}] ... \item[\act{V}] ... \end{protocol}
% A protocol as a transcript: each step is labelled by who sends to whom, or who computes.
% \phase{Round $j=1,\dots,\ell$} starts a group of steps. Numbered "Protocol N.k"; label prot:key:name.
\newcounter{protocol}[chapter]
\renewcommand*{\theprotocol}{\thechapter.\arabic{protocol}}
\crefname{protocol}{Protocol}{Protocols}
\newlength{\vi@protlabel}
\setlength{\vi@protlabel}{4.3em}
\newcommand{\phase}[1]{\item[]\hspace*{-\leftmargin}{\textsc{\color{prover}#1}}}
\newenvironment{protocol}[1]{%
  \refstepcounter{protocol}\def\@currentlabelname{#1}%
  \begin{tcolorbox}[enhanced,breakable,colback=vellum,frame hidden,boxrule=0pt,arc=0pt,
    borderline north={0.5pt}{0pt}{prover!75},borderline south={0.5pt}{0pt}{verifier!85},
    left=3.4mm,right=3.4mm,top=1.2mm,bottom=1.8mm,
    title={\textsc{protocol \theprotocol}\enspace\textperiodcentered\enspace\textsc{#1}},
    fonttitle=\normalfont,coltitle=prover,colbacktitle=vellum,toptitle=1.4mm,bottomtitle=0.2mm,
    before skip=1.8ex,after skip=1.8ex]
  \begin{list}{}{\setlength{\labelwidth}{\vi@protlabel}\setlength{\labelsep}{0.7em}%
      \setlength{\leftmargin}{\dimexpr\vi@protlabel+0.7em\relax}\setlength{\itemsep}{0.5ex}%
      \setlength{\topsep}{0.4ex}\setlength{\parsep}{0.3ex}\setlength{\itemindent}{0pt}%
      \renewcommand{\makelabel}[1]{##1\hfil}}}
  {\end{list}\end{tcolorbox}}

% \protocolcard{checks}{parties}{honesty}{verifier's cost}{catching a lie}{rests on}
% The end-of-chapter card: what the protocol checks, who takes part, the answers to the book's
% three questions, and the assumptions the answers rest on.
\DeclareRobustCommand*{\vi@qmark}[1]{\tikz[baseline=(q.base)]\node[circle,fill=verifier,text=white,inner sep=0pt,
  minimum size=1.15em,font=\sffamily\scriptsize\bfseries] (q) {#1};}
\newcommand{\vi@cardrow}[2]{\par\noindent\hangindent=9.2em\hangafter=1
  \makebox[9.2em][l]{#1}\ignorespaces#2\par\vspace{0.55ex}}
\newcommand{\protocolcard}[6]{%
  \begin{tcolorbox}[enhanced,breakable,colback=white,colframe=prover!50,boxrule=0.5pt,arc=0pt,
    left=3mm,right=3mm,top=1.9mm,bottom=1.2mm,
    title={\textsc{protocol card}\Ifstr{\vi@chapprotocol}{}{}{\enspace\textperiodcentered\enspace\textsc{\vi@chapprotocol}}},
    fonttitle=\normalfont,coltitle=white,colbacktitle=prover,toptitle=1mm,bottomtitle=1mm,
    before skip=1.8ex,after skip=1.8ex,fontupper=\small]
  \vi@cardrow{\textsc{\color{prover}checks}}{#1}%
  \vi@cardrow{\textsc{\color{prover}parties}}{#2}%
  \vi@cardrow{\vi@qmark{1}\enspace\textsc{\color{verifier}honesty}}{#3}%
  \vi@cardrow{\vi@qmark{2}\enspace\textsc{\color{verifier}verifier's cost}}{#4}%
  \vi@cardrow{\vi@qmark{3}\enspace\textsc{\color{verifier}catching a lie}}{#5}%
  \vi@cardrow{\textsc{\color{prover}rests on}}{#6}%
  \end{tcolorbox}}
% the three questions as paragraph heads in "The three questions" section
\newcommand{\questionone}{\paragraph{\texorpdfstring{\vi@qmark{1}\enspace}{1. }Is honesty an equilibrium?}}
\newcommand{\questiontwo}{\paragraph{\texorpdfstring{\vi@qmark{2}\enspace}{2. }What does the verifier spend?}}
\newcommand{\questionthree}{\paragraph{\texorpdfstring{\vi@qmark{3}\enspace}{3. }How often is a lie caught?}}

% \begin{dictionary} protocol side & oversight side \\ ... \end{dictionary}
\newenvironment{dictionary}[1][Dictionary]{%
  \begin{tcolorbox}[enhanced,breakable,colback=white,colframe=prover!45,boxrule=0.5pt,arc=0pt,
    left=3mm,right=3mm,top=1.4mm,bottom=1.2mm,title={\textsc{\MakeLowercase{#1}}},
    fonttitle=\normalfont,coltitle=prover,colbacktitle=indigowash,toptitle=0.8mm,bottomtitle=0.8mm,
    before skip=1.6ex,after skip=1.6ex,fontupper=\small]%
  \renewcommand{\arraystretch}{1.12}%
  \begin{tabular}{@{}>{\raggedright\arraybackslash}p{0.44\linewidth}@{\hspace{0.04\linewidth}}>{\raggedright\arraybackslash}p{0.52\linewidth}@{}}%
  \textsc{\color{prover}in the protocol} & \textsc{\color{verifier}in oversight}\\[0.2ex]}
  {\end{tabular}\end{tcolorbox}}

%------------------------------------------------------------------------------
% Plots: honest and cheating provers against the bounds of the theory
%------------------------------------------------------------------------------
\pgfplotscreateplotcyclelist{vicycle}{%
  {prover,line width=1.0pt},%
  {verifier,line width=1.0pt,dashed},%
  {proverB,line width=1.0pt,densely dotted},%
  {muted,line width=0.9pt,dashdotted}}
\pgfplotsset{
  vplot/.style={width=0.92\linewidth,height=0.58\linewidth,
    axis line style={muted!80},tick style={muted!80},major tick length=2.5pt,
    every tick label/.append style={font=\footnotesize,text=ink},
    label style={font=\small,text=ink},title style={font=\small},
    legend style={draw=none,fill=white,fill opacity=0.85,text opacity=1,font=\footnotesize},
    legend cell align=left,cycle list name=vicycle,scaled ticks=false,
    tick label style={/pgf/number format/fixed}},
  % exact predictions and bounds of the theory
  theory/.style={prover,line width=1.0pt,no marks},
  theory2/.style={proverB,line width=1.0pt,dashed,no marks},
  bound/.style={prover!70,line width=0.8pt,dash pattern=on 3pt off 2pt,no marks},
  % measured acceptance rates of provers: honest (filled indigo), cheating (ochre, hollow)
  honest/.style={only marks,mark=*,mark size=1.6pt,color=prover,
    mark options={fill=prover,draw=white,line width=0.2pt}},
  cheat/.style={only marks,mark=o,mark size=1.7pt,color=verifier,
    mark options={line width=0.6pt,fill=white}},
  cheat2/.style={only marks,mark=square,mark size=1.5pt,color=proverB,
    mark options={line width=0.6pt,fill=white}},
  ebars/.style={error bars/y dir=both,error bars/y explicit,
    error bars/error bar style={line width=0.5pt},
    error bars/error mark options={rotate=90,mark size=1.6pt,line width=0.5pt}},
  guide/.style={muted,line width=0.5pt,densely dashed,no marks},
  band/.style={fill=prover!10,draw=none},
}

