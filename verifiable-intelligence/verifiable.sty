%% verifiable.sty -- volume style for "Verifiable Intelligence: Interactive Proofs as a Theory
%% of AI Oversight" (The Missing Textbooks, volume 5). Loaded after missingbook.cls by main.tex
%% and by tools/build_chapter.sh. Chapters must not load packages of their own.
%%
%% The design has two voices. The prover (the machine) writes in indigo, the book's ink: structure,
%% links and the rules of theorem boxes. The verifier (the human, or the weaker system that stands
%% in for one) marks in ochre: the queried bits, the verdicts, the three questions. A second prover
%% or debater is teal; a human judge consulted as an oracle is sage. The ornaments are transcripts:
%% two rails under each chapter title, and at the foot of each opening page the message pattern of
%% the chapter's protocol, drawn between a prover rail and a verifier rail. The title page carries
%% the Hadamard encoding of 1985, with the three bits that a linearity test reads. The series class
%% is not modified: its colour names are re-pointed to this palette and its ornament macros are
%% redefined here.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{verifiable}[2026/10/19 v1.0 volume style for Verifiable Intelligence]

\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween,groupplots}
\usetikzlibrary{fadings}
\RequirePackage[scale=0.86]{sourcecodepro}
\RequirePackage{siunitx}

%------------------------------------------------------------------------------
% Palette
%------------------------------------------------------------------------------
\definecolor{prover}{RGB}{46,52,118}        % indigo: the prover's ink; structure and links
\definecolor{proverdeep}{RGB}{27,30,72}     % part titles, imprint
\definecolor{proverB}{RGB}{0,110,108}       % teal: a second prover or debater
\definecolor{verifier}{RGB}{176,104,12}     % ochre: the verifier's marks
\definecolor{oracle}{RGB}{88,116,84}        % sage: a human judge consulted as an oracle; nature's samples
\definecolor{vellum}{RGB}{250,247,240}      % cream of definition and protocol boxes
\definecolor{vellumline}{RGB}{216,201,170}  % rules of cream boxes
\definecolor{indigowash}{RGB}{238,239,248}  % pale tint of theorem boxes
\definecolor{ochrewash}{RGB}{251,245,232}   % pale tint of the oversight-problem box
% the series class draws with these names
\colorlet{sea}{prover}
\colorlet{seadeep}{proverdeep}
\colorlet{seafoam}{indigowash}
\colorlet{seamist}{prover!12}
\colorlet{sand}{vellum}
\colorlet{sandline}{vellumline}
\hypersetup{linkcolor=prover,citecolor=prover,urlcolor=prover}

% the chapter number in the margin, in a light ochre
\renewcommand*{\mb@chapnumfont}{\normalfont\fontsize{64}{64}\selectfont\color{verifier!48}}

%------------------------------------------------------------------------------
% Two rails: a prover rail (indigo) above a verifier rail (ochre). They replace the series'
% wave rule under chapter titles and on part pages.
%------------------------------------------------------------------------------
\newlength{\vi@len}
\newcommand*{\vi@rails}[1]{%
  \setlength{\vi@len}{#1}%
  \begin{tikzpicture}
    \draw[prover!72,line width=0.45pt] (0,1mm) -- (\vi@len,1mm);
    \draw[verifier!85,line width=0.45pt] (0,0) -- (\vi@len,0);
  \end{tikzpicture}}
\renewcommand*{\mb@waverule}[1][]{%
  \par\noindent\makebox[\linewidth][l]{%
    \vi@rails{\dimexpr\linewidth+\marginparsep+\marginparwidth\relax}}\par}
\renewcommand{\casepart}[3]{%
  \setpartpreamble[c][0.78\textwidth]{%
    \vspace{2.2\baselineskip}{\centering\vi@rails{\linewidth}\par}\vspace{1.2\baselineskip}%
    {\normalfont\itshape\color{muted}\setlength{\parindent}{0pt}#2\par}%
    \risingsea{#3}}%
  \part{#1}}

%------------------------------------------------------------------------------
% The transcript band at the foot of an opening page. A prover rail and a verifier rail run
% across the page; the chapter's protocol is drawn on them as a sequence of tokens, one slot per
% token, from the left edge of the text block:
%   P  a message from the prover to the verifier          p  the same, short
%   A  a message from a second prover or debater (teal)   a  the same, short
%   V  a message from the verifier to the prover (its random challenge or question)
%   S  the proof string: a row of cells along the prover rail (put it first)
%   Q  the verifier reads one cell of the proof string     K  a hidden cell that no query reads
%   C  a commitment: a sealed message from the prover
%   H  the verifier consults the human judge (an oracle below the verifier rail)
%   X  the verifier draws samples from the world (dots below the verifier rail)
%   R  the verifier pays the prover (a reward)
%   D  the verdict                                          o  an empty slot
% Example: \vi@band{P,V,P,V,P,V,D} (the sumcheck protocol with three variables).
%------------------------------------------------------------------------------
\newcommand*{\vi@railP}{19}   % mm above the bottom edge of the page
\newcommand*{\vi@railV}{8}
\newcommand*{\vi@xstart}{24}  % the left edge of the text block, in mm
\newcount\vi@ntok
% the first 86 bits of the title page's codeword fill the cells of the proof string
\newcommand*{\vi@stripbits}{00110110011101001110010100000100110101100010100101001100011111000011110000010110111010}
\newcommand*{\vi@arrow}{-{Stealth[length=1.5mm,width=1.15mm]}}
% a message between rails: #1 colour, #2 line width, #3 start height, #4 end height
\newcommand*{\vi@message}[4]{%
  \fill[#1] (\vi@x,#3) circle (0.42);
  \draw[#1,line width=#2,\vi@arrow] (\vi@x,#3) -- (\vi@x+0.58*\vi@w,#4);}
\newcommand*{\vi@cellx}{0}
% the centre of the strip cell nearest to the middle of the current slot
\newcommand*{\vi@setcell}{\pgfmathsetmacro{\vi@cellx}{25+2*round((\vi@x+0.29*\vi@w-25)/2)}}
\newcommand*{\vi@tok@P}{\vi@message{prover}{1.05pt}{\vi@railP}{\vi@railV+0.25}}
\newcommand*{\vi@tok@p}{\vi@message{prover}{0.5pt}{\vi@railP}{\vi@railV+0.25}}
\newcommand*{\vi@tok@A}{\vi@message{proverB}{1.05pt}{\vi@railP}{\vi@railV+0.25}}
\newcommand*{\vi@tok@a}{\vi@message{proverB}{0.5pt}{\vi@railP}{\vi@railV+0.25}}
\newcommand*{\vi@tok@V}{\vi@message{verifier}{0.55pt}{\vi@railV}{\vi@railP-0.25}}
\newcommand*{\vi@tok@C}{%
  \vi@message{prover}{1.05pt}{\vi@railP}{\vi@railV+0.25}%
  \fill[prover,draw=white,line width=0.3pt] (\vi@x+0.29*\vi@w,{(\vi@railP+\vi@railV)/2}) +(-0.95,-0.75) rectangle +(0.95,0.75);}
\newcommand*{\vi@tok@R}{%
  \vi@message{verifier}{0.55pt}{\vi@railV}{\vi@railP-0.25}%
  \draw[verifier,fill=white,line width=0.55pt] (\vi@x+0.29*\vi@w,{(\vi@railP+\vi@railV)/2}) circle (1.05);
  \fill[verifier] (\vi@x+0.29*\vi@w,{(\vi@railP+\vi@railV)/2}) circle (0.45);}
\tikzset{vi@cell0/.style={fill=white},vi@cell1/.style={fill=prover!26}}
\newcount\vi@k
\def\vi@stripcell#1{%
  \ifx#1\relax\else
    \pgfmathparse{(24.2+2*\the\vi@k+1.6<=\vi@railxb)?1:0}%
    \ifnum\pgfmathresult=1\relax
      \path[draw=prover!45,line width=0.25pt,vi@cell#1] (24.2+2*\the\vi@k,\vi@railP-0.8) rectangle ++(1.6,1.6);
    \fi
    \advance\vi@k by 1\relax
    \expandafter\vi@stripcell\fi}
\newcommand*{\vi@tok@S}{\vi@k=0\relax\expandafter\vi@stripcell\vi@stripbits\relax}
\newcommand*{\vi@tok@Q}{%
  \vi@setcell
  \fill[verifier] (\vi@cellx,\vi@railV) circle (0.42);
  \draw[verifier,line width=0.55pt] (\vi@cellx,\vi@railV) -- (\vi@cellx,\vi@railP-1.15);
  \fill[verifier,draw=verifier,line width=0.25pt] (\vi@cellx-0.8,\vi@railP-0.8) rectangle ++(1.6,1.6);}
\newcommand*{\vi@tok@K}{%
  \vi@setcell
  \fill[proverdeep,draw=proverdeep,line width=0.25pt] (\vi@cellx-0.8,\vi@railP-0.8) rectangle ++(1.6,1.6);}
\newcommand*{\vi@tok@H}{%
  \fill[verifier] (\vi@x+0.29*\vi@w,\vi@railV) circle (0.42);
  \draw[oracle,line width=0.55pt] (\vi@x+0.29*\vi@w,\vi@railV) -- (\vi@x+0.29*\vi@w,3.6);
  \fill[oracle] (\vi@x+0.29*\vi@w,3.1) +(0,-1.15) -- +(1.15,0) -- +(0,1.15) -- +(-1.15,0) -- cycle;}
\newcommand*{\vi@tok@X}{%
  \foreach \vi@dx/\vi@dy in {0.0/3.4,0.9/5.0,1.9/3.0,2.8/4.6,3.7/3.3}{%
    \fill[oracle] (\vi@x+\vi@dx,\vi@dy) circle (0.42);}}
\newcommand*{\vi@tok@D}{%
  \fill[verifier] (\vi@x+0.29*\vi@w,\vi@railV) circle (1.55);
  \draw[white,line width=0.6pt,line cap=round,line join=round]
    (\vi@x+0.29*\vi@w-0.75,\vi@railV+0.02) -- (\vi@x+0.29*\vi@w-0.2,\vi@railV-0.6) -- (\vi@x+0.29*\vi@w+0.8,\vi@railV+0.7);}
\newcommand*{\vi@tok@o}{}
% \vi@banddraw{tokens}: rails and tokens in page coordinates (mm); the rails run from \vi@railx0
% to \vi@railx1
\newcommand*{\vi@railxa}{0}
\newcommand*{\vi@railxb}{210}
\newcommand*{\vi@bandwidth}{171}  % mm available to the slots
\newcommand{\vi@banddraw}[1]{%
  \global\vi@ntok=0\relax
  \foreach \vi@t in {#1}{\global\advance\vi@ntok by 1\relax}%
  \pgfmathsetmacro{\vi@w}{min(15,\vi@bandwidth/max(\the\vi@ntok,1))}%
  \draw[prover!30,line width=0.35pt] (\vi@railxa,\vi@railP) -- (\vi@railxb,\vi@railP);
  \draw[verifier!50,line width=0.35pt] (\vi@railxa,\vi@railV) -- (\vi@railxb,\vi@railV);
  \node[font=\sffamily\scriptsize,text=prover!75,anchor=east,inner sep=0pt] at (20.5,\vi@railP) {P};
  \node[font=\sffamily\scriptsize,text=verifier,anchor=east,inner sep=0pt] at (20.5,\vi@railV) {V};
  \foreach \vi@t [count=\vi@i] in {#1}{%
    \pgfmathsetmacro{\vi@x}{\vi@xstart+(\vi@i-1)*\vi@w}%
    \ifcsname vi@tok@\vi@t\endcsname\csname vi@tok@\vi@t\endcsname
    \else\PackageWarning{verifiable}{Unknown band token `\vi@t'}\fi}}
\newcommand{\vi@band}[1]{%
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=1mm]
    \begin{scope}[shift={(current page.south west)}]\vi@banddraw{#1}\end{scope}
  \end{tikzpicture}}
% \inlineband{tokens}: the same band as a picture in the text, spanning text block and margin
% (use it inside fullwidth); the rails start at the labels
\newcommand{\inlineband}[1]{%
  \begin{tikzpicture}[x=1mm,y=1mm]
    \begin{scope}[shift={(-14,-2.5)}]%
      \def\vi@railxa{14}\def\vi@railxb{184.5}\def\vi@bandwidth{158}%
      \useasboundingbox (14,2.5) rectangle (184.5,22);
      \vi@banddraw{#1}%
    \end{scope}
  \end{tikzpicture}}
% the class calls \risingsea on part pages and special chapters; here its argument is a band
\renewcommand*{\risingsea}[1]{\vi@band{#1}}

%------------------------------------------------------------------------------
% Chapter openings
%   \protocolchapter{Title}{Subtitle}{Protocol}{band}{label}
% prints the title, the subtitle, "the protocol -- <name>", the two rails, and the band at the
% foot of the page. The protocol's name is also printed in the table of contents and heads the
% chapter's protocol card.
%------------------------------------------------------------------------------
\newcommand*{\vi@chapprotocol}{}
% the protocol's name goes at the right end of the subtitle's line if it fits, and flush right on
% a line of its own otherwise (the TeXbook's trick for a right-aligned final item)
\newcommand*{\vi@tocsubtitle}[2]{%
  \par\nopagebreak\vspace{-0.15ex}{\leftskip=2.3em\small\itshape\color{muted}#1%
    \Ifstr{#2}{}{}{\unskip\nobreak\hfil\penalty50\hskip1.5em\hbox{}\nobreak\hfil
      \mbox{\upshape\scshape\color{verifier}#2}{\parfillskip=0pt\finalhyphendemerits=0\par}}\par}\vspace{0.35ex}}
\newcommand{\vi@openerblock}[2]{%
  \vspace*{-0.2\baselineskip}%
  {\raggedright\large\itshape\color{muted}#1\par}%
  \Ifstr{#2}{}{}{%
    \vspace{0.55\baselineskip}%
    {\raggedright\small\textsc{\color{verifier}the protocol}\enspace{\color{verifier}\rule[0.32ex]{1.6em}{0.4pt}}\enspace\textsc{#2}\par}}%
  \vspace{0.5\baselineskip}%
  \mb@waverule
  \vspace{0.9\baselineskip}}
\newcommand{\protocolchapter}[5]{%
  \chapter[head={#1},tocentry={#1}]{#1}\label{#5}%
  \addtocontents{toc}{\protect\vi@tocsubtitle{#2}{#3}}%
  \gdef\vi@chapprotocol{#3}%
  \vi@band{#4}%
  \vi@openerblock{#2}{#3}%
  \@afterindentfalse\@afterheading}
% an appendix chapter: \appendixchapter{Title}{Subtitle}{label}; its band is empty rails
\newcommand{\appendixchapter}[3]{%
  \chapter[head={#1},tocentry={#1}]{#1}\label{#3}%
  \addtocontents{toc}{\protect\mbtocsubtitle{#2}}%
  \gdef\vi@chapprotocol{}%
  \vi@band{o}%
  \vi@openerblock{#2}{}%
  \@afterindentfalse\@afterheading}
\renewcommand{\casechapter}[4]{%
  \chapter[head={#1},tocentry={#1}]{#1}\label{#4}%
  \addtocontents{toc}{\protect\mbtocsubtitle{#2}}%
  \gdef\vi@chapprotocol{#3}%
  \vi@band{o}%
  \vi@openerblock{#2}{#3}%
  \@afterindentfalse\@afterheading}
\renewcommand{\specialchapter}[3]{%
  \addchap[head={#1},tocentry={#1}]{#1}%
  \addtocontents{toc}{\protect\mbtocsubtitle{#2}}%
  \gdef\vi@chapprotocol{}%
  \vi@band{#3}%
  \vi@openerblock{#2}{}%
  \@afterindentfalse\@afterheading}

% Figures and tables of an unnumbered chapter (the prologue, the epilogue) are numbered with a
% letter: \vifloatprefix{P} after its heading, \vifloatrestore at its end.
\newcommand*{\vifloatprefix}[1]{%
  \global\let\vi@origthefigure\thefigure\global\let\vi@origthetable\thetable
  \global\let\vi@origtheHfigure\theHfigure\global\let\vi@origtheHtable\theHtable
  \setcounter{figure}{0}\setcounter{table}{0}%
  \gdef\thefigure{#1.\arabic{figure}}\gdef\thetable{#1.\arabic{table}}%
  \gdef\theHfigure{#1.\arabic{figure}}\gdef\theHtable{#1.\arabic{table}}}
\newcommand*{\vifloatrestore}{%
  \global\let\thefigure\vi@origthefigure\global\let\thetable\vi@origthetable
  \global\let\theHfigure\vi@origtheHfigure\global\let\theHtable\vi@origtheHtable
  \setcounter{figure}{0}\setcounter{table}{0}}

