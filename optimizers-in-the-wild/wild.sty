%------------------------------------------------------------------------------
% Title-page emblem: one gradient and its three steepest-descent directions.
% The unit balls of the l1, l2 and l-infinity norms, standing in the water; for the gradient g at
% angle 28 degrees, the arrows end at the points of each ball that maximize <g,u>: g/|g| on the
% circle, the corner sign(g) of the square, and the vertex e_1 of the diamond.
%------------------------------------------------------------------------------
\renewcommand{\mbtitleemblem}{%
  \begin{scope}[shift={(15.0,8.85)}]
    \fill[white,opacity=0.55] (-1.65,-1.65) rectangle (1.65,1.65);
    \draw[seadeep!65,line width=0.55pt] (-1.65,-1.65) rectangle (1.65,1.65);
    \draw[sea!75,line width=0.55pt] (0,0) circle (1.65);
    \draw[sandline!70!black,line width=0.55pt] (1.65,0) -- (0,1.65) -- (-1.65,0) -- (0,-1.65) -- cycle;
    \draw[muted!80,line width=0.4pt,densely dashed] (0,0) -- (28:2.75);
    \node[font=\scriptsize,text=muted,anchor=south west,inner sep=1.5pt] at (28:2.75) {$g$};
    \draw[-stealth,sandline!55!black,line width=0.95pt] (0,0) -- (1.65,0);
    \draw[-stealth,sea,line width=0.95pt] (0,0) -- (28:1.65);
    \draw[-stealth,seadeep,line width=0.95pt] (0,0) -- (1.65,1.65);
    \fill[ink] (0,0) circle (0.045);
    \node[font=\scriptsize,text=seadeep,anchor=south west,inner sep=1.5pt] at (1.65,1.65) {$\ell_\infty$};
    \node[font=\scriptsize,text=sea,anchor=south east,inner sep=1pt] at (135:1.68) {$\ell_2$};
    \node[font=\scriptsize,text=sandline!55!black,anchor=north,inner sep=1.5pt] at (1.18,-0.04) {$\ell_1$};
  \end{scope}}

%------------------------------------------------------------------------------
% Plots: pgfplots in the series palette ("wplot"; "hplot" kept as an alias for volume 2 habits)
%------------------------------------------------------------------------------
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}
\usepgfplotslibrary{fillbetween,groupplots}
\pgfplotscreateplotcyclelist{wildcycle}{%
  {sea,line width=1.1pt},%
  {sandline!55!black,line width=1.1pt,dashed},%
  {seadeep,line width=1.0pt,densely dotted},%
  {muted,line width=0.9pt,dashdotted}}
\pgfplotsset{
  wplot/.style={width=0.92\linewidth,height=0.58\linewidth,
    axis line style={muted!80},tick style={muted!80},major tick length=2.5pt,
    every tick label/.append style={font=\footnotesize,text=ink},
    label style={font=\small,text=ink},title style={font=\small},
    legend style={draw=none,fill=white,fill opacity=0.85,text opacity=1,font=\footnotesize},
    legend cell align=left,cycle list name=wildcycle,scaled ticks=false,
    tick label style={/pgf/number format/fixed}},
  hplot/.style={wplot},
  theory/.style={sea,line width=1.1pt,no marks},
  theory2/.style={seadeep,line width=1.0pt,dashed,no marks},
  theory3/.style={sandline!55!black,line width=1.0pt,no marks},
  simulation/.style={only marks,mark=*,mark size=1.7pt,color=sandline!55!black,
    mark options={fill=sandline!55!black,draw=white,line width=0.2pt}},
  simulation2/.style={only marks,mark=square*,mark size=1.5pt,color=seadeep,
    mark options={fill=seadeep,draw=white,line width=0.2pt}},
  guide/.style={muted,line width=0.5pt,densely dashed,no marks},
  band/.style={fill=seamist,draw=none,opacity=0.8},
}

%------------------------------------------------------------------------------
% New theorem-like environments (sharing the chapter's theorem counter)
%------------------------------------------------------------------------------
\theoremstyle{mbdefinition}
\mb@newsharedtheorem{assumption}{Assumption}
\tcolorboxenvironment{assumption}{mbdef}
\theoremstyle{mbremark}
\mb@newsharedtheorem{observation}{Observation}
\crefname{assumption}{Assumption}{Assumptions}
\crefname{observation}{Observation}{Observations}
\theoremstyle{mbplain}

% A heuristic derivation: an argument that is not a proof. It ends with a diamond instead of the
% tombstone, and \qedhere works inside it as in a proof.
\newcommand*{\wild@diamond}{\leavevmode\unskip\penalty9999 \hbox{}\nobreak\hfill\quad\hbox{$\Diamond$}}
\newenvironment{heuristic}[1][Heuristic derivation]{\par\pushQED{\wild@diamond}\normalfont
  \topsep5\p@\@plus5\p@\relax\trivlist\item[\hskip\labelsep\scshape #1.]\ignorespaces}
  {\popQED\endtrivlist\@endpefalse}

%------------------------------------------------------------------------------
% Signature boxes of this volume
%------------------------------------------------------------------------------
% \begin{practice}[source] ... \end{practice}: a rule as practitioners use it
\newtcolorbox{practice}[1][]{enhanced,breakable,colback=sand,frame hidden,boxrule=0pt,arc=0pt,
  borderline west={1.3pt}{0pt}{seadeep},left=3.2mm,right=3mm,top=1.7mm,bottom=1.7mm,
  before skip=1.3ex plus 0.5ex,after skip=1.3ex plus 0.5ex,
  before upper={\textsc{\color{seadeep}in the wild}\Ifstr{#1}{}{}{\enspace{\color{seadeep}\textperiodcentered}\enspace#1}%
    {\color{seadeep}.}\enspace}}

% \begin{dictionary} theory side & training-run side \\ ... \end{dictionary}
\newenvironment{dictionary}[1][Dictionary]{%
  \begin{tcolorbox}[enhanced,breakable,colback=white,colframe=sea!45,boxrule=0.5pt,arc=0pt,
    left=3mm,right=3mm,top=1.4mm,bottom=1.2mm,title={\textsc{\MakeLowercase{#1}}},
    fonttitle=\normalfont,coltitle=sea,colbacktitle=seafoam,toptitle=0.8mm,bottomtitle=0.8mm,
    before skip=1.6ex,after skip=1.6ex,fontupper=\small]%
  \renewcommand{\arraystretch}{1.12}%
  \begin{tabular}{@{}>{\raggedright\arraybackslash}p{0.40\linewidth}@{\hspace{0.04\linewidth}}>{\raggedright\arraybackslash}p{0.56\linewidth}@{}}%
  \textsc{\color{sea}in the theory} & \textsc{\color{sea}in a training run}\\[0.2ex]}
  {\end{tabular}\end{tcolorbox}}

% \begin{fieldguide}{Name}{first described} \fgrow{label}{content} ... \end{fieldguide}
\newcommand*{\wild@fglabel}[1]{\textsc{\textcolor{sea}{#1}}}
\newcommand{\fgrow}[2]{\par\noindent\hangindent=8.8em\hangafter=1
  \makebox[8.8em][l]{\wild@fglabel{#1}}#2\par\vspace{0.45ex}}
\newenvironment{fieldguide}[2]{%
  \begin{tcolorbox}[enhanced,breakable,colback=white,colframe=seadeep!45,boxrule=0.5pt,arc=0pt,
    left=3mm,right=3mm,top=1.8mm,bottom=1.2mm,
    title={\textsc{field guide}\enspace\textperiodcentered\enspace\textsc{#1}\hfill{\small\itshape #2}},
    fonttitle=\normalfont,coltitle=seadeep,colbacktitle=seafoam,toptitle=0.8mm,bottomtitle=0.8mm,
    before skip=1.6ex,after skip=1.6ex,fontupper=\small]}
  {\end{tcolorbox}}

% \fieldnotes{practice}{idealization}{proved}{predicts}{misses}{takeaway}
\newcommand*{\wild@cardlabel}[1]{\textsc{\textcolor{sea}{#1}}}
\newcommand{\wild@cardrow}[2]{\par\noindent\hangindent=8.2em\hangafter=1
  \makebox[8.2em][l]{\wild@cardlabel{#1}}#2\par\vspace{0.5ex}}
\newcommand{\fieldnotes}[6]{%
  \begin{tcolorbox}[enhanced,breakable,colback=white,colframe=sea!45,boxrule=0.5pt,arc=0pt,
    left=3mm,right=3mm,top=1.8mm,bottom=1.2mm,title={\textsc{field notes}},
    fonttitle=\normalfont,coltitle=white,colbacktitle=sea,toptitle=0.9mm,bottomtitle=0.9mm,
    before skip=1.6ex,after skip=1.6ex,fontupper=\small]
  \wild@cardrow{practice}{#1}%
  \wild@cardrow{idealization}{#2}%
  \wild@cardrow{proved}{#3}%
  \wild@cardrow{predicts}{#4}%
  \wild@cardrow{misses}{#5}%
  \wild@cardrow{takeaway}{#6}%
  \end{tcolorbox}}

